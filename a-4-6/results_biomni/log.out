3. [✓] Implement cell-type-specific association testing methodology

<execute>
print("Step 3: Implementing cell-type-specific association testing...")

from sklearn.linear_model import LinearRegression
from scipy.stats import t
import statsmodels.api as sm

def cell_type_specific_association_test(methylation_data, cell_types, covariates, traits):
    """
    Perform cell-type-specific association testing for DNA methylation data.
    
    This implements the methodology where we test for associations between:
    - CpG methylation levels (response)
    - Disease status and covariates (predictors)
    - Across different cell types (using cell type composition as weights/interactions)
    
    For each CpG site and each cell type, we model:
    methylation ~ disease + covariates + cell_type_proportion + interactions
    """
    
    results = []
    
    # Ensure sample alignment
    common_samples = list(set(methylation_data.columns) & 
                         set(cell_types.index) & 
                         set(covariates.index) & 
                         set(traits.index))
    
    # Subset all data to common samples
    meth_aligned = methylation_data[common_samples]
    cell_aligned = cell_types.loc[common_samples]
    cov_aligned = covariates.loc[common_samples]
    trait_aligned = traits.loc[common_samples]
    
    print(f"Processing {len(meth_aligned.index)} CpG sites × {len(cell_aligned.columns)} cell types...")
    
    # For each CpG site
    for cpg_idx, cpg in enumerate(meth_aligned.index):
        if cpg_idx % 5 == 0:
            print(f"Processing CpG {cpg_idx+1}/{len(meth_aligned.index)}: {cpg}")
        
        # Get methylation values for this CpG
        y = meth_aligned.loc[cpg].values
        
        # For each cell type
        for cell_type in cell_aligned.columns:
            
            # Create design matrix
            X_data = []
            term_names = []
            
            # Add intercept
            X_data.append(np.ones(len(common_samples)))
            term_names.append('(Intercept)')
            
            # Add disease status
            X_data.append(trait_aligned['disease'].values)
            term_names.append('disease')
            
            # Add covariates
            for cov in cov_aligned.columns:
                X_data.append(cov_aligned[cov].values)
                term_names.append(cov)
            
            # Add cell type proportion
            cell_prop = cell_aligned[cell_type].values
            X_data.append(cell_prop)
            term_names.append(f'{cell_type}_proportion')
            
            # Add interaction between disease and cell type proportion
            X_data.append(trait_aligned['disease'].values * cell_prop)
            term_names.append(f'disease:{cell_type}_proportion')
            
            # Convert to matrix
            X = np.column_stack(X_data)
            
            try:
                # Fit linear model using statsmodels for proper statistics
                model = sm.OLS(y, X).fit()
                
                # Extract results for each term
                for i, term in enumerate(term_names):
                    result = {
                        'response': cpg,
                        'cell_type': cell_type,
                        'term': term,
                        'estimate': model.params[i],
                        'statistic': model.tvalues[i],
                        'p.value': model.pvalues[i]
                    }
                    results.append(result)
                    
            except Exception as e:
                print(f"Warning: Failed to fit model for {cpg} × {cell_type}: {str(e)}")
                # Add NA results
                for term in term_names:
                    result = {
                        'response': cpg,
                        'cell_type': cell_type,
                        'term': term,
                        'estimate': np.nan,
                        'statistic': np.nan,
                        'p.value': np.nan
                    }
                    results.append(result)
    
    return pd.DataFrame(results)

# Run the analysis
print("Running cell-type-specific association testing...")
results_df = cell_type_specific_association_test(bulk_omics, cell_types, covariates, traits)

print(f"\nAnalysis complete! Generated {len(results_df)} association tests.")
print(f"Shape: {results_df.shape}")
print("\nFirst few results:")
print(results_df.head(10))
</execute>
