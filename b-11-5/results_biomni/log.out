# 1. Create hierarchical_model_summary.txt
print("Creating hierarchical model summary...")

with open(summary_file, 'w') as f:
    f.write("Hierarchical Model Summary\n")
    f.write("=" * 50 + "\n\n")
    
    f.write("Parameter Posterior Estimates\n")
    f.write("-" * 30 + "\n")
    f.write(f"{'Parameter':<30} {'Mean':<10} {'SD':<10} {'2.5%':<10} {'97.5%':<10}\n")
    f.write("-" * 70 + "\n")
    
    for _, row in summary_df.iterrows():
        f.write(f"{row['parameter']:<30} {row['mean']:<10.4f} {row['std']:<10.4f} {row['q025']:<10.4f} {row['q975']:<10.4f}\n")
    
    f.write("\n" + "=" * 50 + "\n")
    f.write("Random Effects Variance Summary\n")
    f.write("-" * 30 + "\n")
    
    # Extract variance-related parameters
    sigma_patient_stats = summary_df[summary_df['parameter'] == 'sigma_patient'].iloc[0]
    sigma_patient_sq_stats = summary_df[summary_df['parameter'] == 'sigma_patient_squared'].iloc[0]
    
    f.write(f"sigma_patient (SD of patient effects):\n")
    f.write(f"  Posterior mean: {sigma_patient_stats['mean']:.4f}\n")
    f.write(f"  Posterior SD: {sigma_patient_stats['std']:.4f}\n")
    f.write(f"  95% Credible interval: [{sigma_patient_stats['q025']:.4f}, {sigma_patient_stats['q975']:.4f}]\n\n")
    
    f.write(f"sigma_patient_squared (Variance of patient effects):\n")
    f.write(f"  Posterior mean: {sigma_patient_sq_stats['mean']:.4f}\n")
    f.write(f"  Posterior SD: {sigma_patient_sq_stats['std']:.4f}\n")
    f.write(f"  95% Credible interval: [{sigma_patient_sq_stats['q025']:.4f}, {sigma_patient_sq_stats['q975']:.4f}]\n")

print(f"Summary file created: {summary_file}")

# 2. Create random_effects_variance_posterior.csv
