Now let me implement the MCMC sampling:

<execute>
def gibbs_sampler(y, X_intercept, X_time, X_patient, n_iter=5000, burn_in=1000):
    """
    Gibbs sampler for hierarchical model:
    y = intercept + X_time * beta_time + X_patient * beta_patient + error
    beta_patient ~ N(mu_patient, sigma_patient^2)
    """
    
    n_obs = len(y)
    n_patients = X_patient.shape[1]
    n_times = X_time.shape[1]
    
    # Initialize parameters
    intercept = np.mean(y)
    beta_time = np.zeros(n_times)
    beta_patient = np.zeros(n_patients)
    mu_patient = 0.0
    sigma_patient_sq = 1.0
    sigma_obs_sq = 1.0
    
    # Storage for samples
    samples = {
        'intercept': np.zeros(n_iter),
        'beta_time': np.zeros((n_iter, n_times)),
        'beta_patient': np.zeros((n_iter, n_patients)),
        'mu_patient': np.zeros(n_iter),
        'sigma_patient_sq': np.zeros(n_iter),
        'sigma_obs_sq': np.zeros(n_iter)
    }
    
    print("Starting MCMC sampling...")
    
    for i in range(n_iter):
        # Update intercept
        residual = y - X_time @ beta_time - X_patient @ beta_patient
        var_intercept = 1.0 / (1.0/100 + n_obs/sigma_obs_sq)  # Prior variance = 100
        mean_intercept = var_intercept * (np.sum(residual)/sigma_obs_sq)
        intercept = np.random.normal(mean_intercept, np.sqrt(var_intercept))
        
        # Update time effects
        residual = y - intercept - X_patient @ beta_patient
        for j in range(n_times):
            X_j = X_time[:, j]
            var_beta = 1.0 / (1.0/25 + np.sum(X_j**2)/sigma_obs_sq)  # Prior variance = 25
            mean_beta = var_beta * (np.sum(X_j * residual)/sigma_obs_sq)
            beta_time[j] = np.random.normal(mean_beta, np.sqrt(var_beta))
            residual -= X_j * beta_time[j]
        
        # Update patient effects
        residual = y - intercept - X_time @ beta_time
        for j in range(n_patients):
            X_j = X_patient[:, j]
            var_beta = 1.0 / (1.0/sigma_patient_sq + np.sum(X_j**2)/sigma_obs_sq)
            mean_beta = var_beta * (mu_patient/sigma_patient_sq + np.sum(X_j * residual)/sigma_obs_sq)
            beta_patient[j] = np.random.normal(mean_beta, np.sqrt(var_beta))
        
        # Update mu_patient (hyperparameter for patient effects)
        var_mu = 1.0 / (1.0/100 + n_patients/sigma_patient_sq)  # Prior variance = 100
        mean_mu = var_mu * (np.sum(beta_patient)/sigma_patient_sq)
        mu_patient = np.random.normal(mean_mu, np.sqrt(var_mu))
        
        # Update sigma_patient_sq (variance of patient effects)
        shape = 1 + n_patients/2  # Prior: InvGamma(1, 1)
        scale = 1 + np.sum((beta_patient - mu_patient)**2)/2
        sigma_patient_sq = 1.0 / np.random.gamma(shape, 1.0/scale)
        
        # Update sigma_obs_sq (observation noise variance)
        residual = y - intercept - X_time @ beta_time - X_patient @ beta_patient
        shape = 1 + n_obs/2  # Prior: InvGamma(1, 1)
        scale = 1 + np.sum(residual**2)/2
        sigma_obs_sq = 1.0 / np.random.gamma(shape, 1.0/scale)
        
        # Store samples
        samples['intercept'][i] = intercept
        samples['beta_time'][i] = beta_time.copy()
        samples['beta_patient'][i] = beta_patient.copy()
        samples['mu_patient'][i] = mu_patient
        samples['sigma_patient_sq'][i] = sigma_patient_sq
        samples['sigma_obs_sq'][i] = sigma_obs_sq
        
        if (i + 1) % 1000 == 0:
            print(f"Iteration {i + 1}/{n_iter}")
    
    # Remove burn-in
    for key in samples:
        samples[key] = samples[key][burn_in:]
    
    return samples

# Run MCMC
print("Running Gibbs sampler...")
samples = gibbs_sampler(y, X_intercept, X_time, X_patient, n_iter=5000, burn_in=1000)
print("MCMC sampling completed!")

# Add derived quantities
samples['sigma_patient'] = np.sqrt(samples['sigma_patient_sq'])
samples['sigma_obs'] = np.sqrt(samples['sigma_obs_sq'])

print("Sample shapes:")
for key, value in samples.items():
    if isinstance(value, np.ndarray):
        print(f"{key}: {value.shape}")
</execute>
