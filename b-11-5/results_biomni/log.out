# 3. Create trace plots
print("Creating trace plots...")

# Group parameters for plotting
param_groups = {
    'Fixed Effects': {
        'intercept': samples['intercept'],
        'time_T1': samples['beta_time'][:, 0],
        'time_T2': samples['beta_time'][:, 1],
        'time_T3': samples['beta_time'][:, 2],
        'time_T4': samples['beta_time'][:, 3]
    },
    'Hyperparameters': {
        'mu_patient': samples['mu_patient'],
        'sigma_patient': samples['sigma_patient'],
        'sigma_obs': samples['sigma_obs']
    },
    'Patient Effects (Sample)': {
        f'patient_{i+1}': samples['beta_patient'][:, i] for i in range(0, 6)  # Show first 6 patients
    }
}

n_groups = len(param_groups)
fig, axes = plt.subplots(n_groups, 2, figsize=(12, 4*n_groups))

if n_groups == 1:
    axes = axes.reshape(1, -1)

for group_idx, (group_name, params) in enumerate(param_groups.items()):
    ax_density = axes[group_idx, 0]
    ax_trace = axes[group_idx, 1]
    
    # Density plots
    for param_name, param_samples in params.items():
        ax_density.hist(param_samples, alpha=0.6, density=True, bins=50, label=param_name)
    ax_density.set_title(f'{group_name} - Posterior Densities')
    ax_density.set_xlabel('Parameter Value')
    ax_density.set_ylabel('Density')
    ax_density.legend(bbox_to_anchor=(1.05, 1), loc='upper left')
    
    # Trace plots
    for param_name, param_samples in params.items():
        ax_trace.plot(param_samples, alpha=0.7, label=param_name)
    ax_trace.set_title(f'{group_name} - MCMC Traces')
    ax_trace.set_xlabel('MCMC Iteration')
    ax_trace.set_ylabel('Parameter Value')
    ax_trace.legend(bbox_to_anchor=(1.05, 1), loc='upper left')

plt.tight_layout()
plt.savefig(plot_file, dpi=300, bbox_inches='tight')
plt.close()

print(f"Trace plot created: {plot_file}")
</execute>
