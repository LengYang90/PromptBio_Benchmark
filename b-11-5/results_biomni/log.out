Now let me calculate summary statistics and generate the output files:

<execute>
def calculate_summary_stats(samples_array, parameter_name):
    """Calculate posterior summary statistics"""
    mean_val = np.mean(samples_array)
    std_val = np.std(samples_array)
    q025 = np.percentile(samples_array, 2.5)
    q975 = np.percentile(samples_array, 97.5)
    
    return {
        'parameter': parameter_name,
        'mean': mean_val,
        'std': std_val,
        'q025': q025,
        'q975': q975
    }

# Calculate summary statistics for all parameters
summary_stats = []

# Intercept
summary_stats.append(calculate_summary_stats(samples['intercept'], 'intercept'))

# Time effects (T1-T4, with T0 as reference)
time_labels = ['T1', 'T2', 'T3', 'T4']
for i, label in enumerate(time_labels):
    summary_stats.append(calculate_summary_stats(samples['beta_time'][:, i], f'time_effect_{label}'))

# Patient effects
for i in range(30):
    patient_id = f'Patient_{i+1:03d}'
    summary_stats.append(calculate_summary_stats(samples['beta_patient'][:, i], f'patient_effect_{patient_id}'))

# Hyperparameters
summary_stats.append(calculate_summary_stats(samples['mu_patient'], 'mu_patient'))
summary_stats.append(calculate_summary_stats(samples['sigma_patient'], 'sigma_patient'))
summary_stats.append(calculate_summary_stats(samples['sigma_patient_sq'], 'sigma_patient_squared'))
summary_stats.append(calculate_summary_stats(samples['sigma_obs'], 'sigma_obs'))

print("Summary statistics calculated for all parameters")
print(f"Total parameters: {len(summary_stats)}")

# Convert to DataFrame for easier handling
summary_df = pd.DataFrame(summary_stats)
print("\nFirst few summary statistics:")
print(summary_df.head(10))
</execute>
