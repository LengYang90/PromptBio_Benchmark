Good! Now let me implement the MR analysis manually using basic R functions since the package installation is problematic:

<execute>
#!R
# Merge the data
merged_data <- merge(snp_exp, snp_pheno, by = c("SNP", "effect_allele", "other_allele"))

print("Merged data:")
print(merged_data)

# Extract the necessary columns for MR analysis
beta_exp <- merged_data$beta_exp     # SNP-exposure association
se_exp <- merged_data$se_exp         # Standard error of SNP-exposure association
beta_pheno <- merged_data$beta_pheno # SNP-outcome association  
se_pheno <- merged_data$se_pheno     # Standard error of SNP-outcome association

print(paste("Number of SNPs for analysis:", length(beta_exp)))

# Function to calculate IVW estimate
ivw_mr <- function(beta_exp, se_exp, beta_pheno, se_pheno) {
    # Weights for IVW
    weights <- 1 / (se_pheno^2)
    
    # IVW estimate
    beta_ivw <- sum(weights * beta_pheno * beta_exp / se_pheno^2) / sum(weights * beta_exp^2 / se_pheno^2)
    
    # Standard error of IVW estimate
    se_ivw <- sqrt(1 / sum(weights * beta_exp^2 / se_pheno^2))
    
    # P-value
    z_ivw <- beta_ivw / se_ivw
    p_ivw <- 2 * pnorm(-abs(z_ivw))
    
    return(list(beta = beta_ivw, se = se_ivw, pval = p_ivw))
}

# Function to calculate MR-Egger estimate
egger_mr <- function(beta_exp, se_exp, beta_pheno, se_pheno) {
    # Weights for MR-Egger
    weights <- 1 / (se_pheno^2)
    
    # Weighted regression: beta_pheno ~ beta_exp
    # Using weighted linear regression
    fit <- lm(beta_pheno ~ beta_exp, weights = weights)
    
    # Extract coefficients
    beta_egger <- coef(fit)[2]  # Slope (causal effect)
    se_egger <- summary(fit)$coefficients[2, 2]  # Standard error of slope
    p_egger <- summary(fit)$coefficients[2, 4]   # P-value of slope
    
    # Intercept (pleiotropy test)
    intercept <- coef(fit)[1]
    intercept_se <- summary(fit)$coefficients[1, 2]
    intercept_p <- summary(fit)$coefficients[1, 4]
    
    return(list(beta = beta_egger, se = se_egger, pval = p_egger,
                intercept = intercept, intercept_se = intercept_se, intercept_p = intercept_p))
}

# Run IVW analysis
print("Running IVW analysis...")
ivw_result <- ivw_mr(beta_exp, se_exp, beta_pheno, se_pheno)
print(paste("IVW Beta:", round(ivw_result$beta, 4)))
print(paste("IVW SE:", round(ivw_result$se, 4)))
print(paste("IVW P-value:", format(ivw_result$pval, scientific = TRUE)))

# Run MR-Egger analysis
print("Running MR-Egger analysis...")
egger_result <- egger_mr(beta_exp, se_exp, beta_pheno, se_pheno)
print(paste("MR-Egger Beta:", round(egger_result$beta, 4)))
print(paste("MR-Egger SE:", round(egger_result$se, 4)))
print(paste("MR-Egger P-value:", format(egger_result$pval, scientific = TRUE)))
print(paste("MR-Egger Intercept:", round(egger_result$intercept, 4)))
print(paste("MR-Egger Intercept P-value:", format(egger_result$intercept_p, scientific = TRUE)))
</execute>
