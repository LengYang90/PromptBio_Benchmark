Now let me predict survival probabilities at t=52 weeks for each patient:

<execute>
# Predict survival probabilities at t=52 weeks
target_time = 52.0

print(f"Predicting survival probabilities at t={target_time} weeks")

# Get survival function for each patient
survival_probs = []
patient_ids = []
shrinkage_groups = []

for idx, row in df.iterrows():
    patient_id = row['PatientID']
    shrinkage_group = row['ShrinkageGroup']
    
    # Create a DataFrame with the patient's covariates
    patient_data = pd.DataFrame({'ShrinkageGroup': [shrinkage_group]})
    
    # Predict survival function for this patient
    survival_func = cph.predict_survival_function(patient_data)
    
    # Get survival probability at target time
    # If target time is beyond the observed times, use the last available probability
    if target_time in survival_func.index:
        survival_prob = survival_func.loc[target_time].iloc[0]
    else:
        # Find the closest time <= target_time
        available_times = survival_func.index[survival_func.index <= target_time]
        if len(available_times) > 0:
            closest_time = available_times.max()
            survival_prob = survival_func.loc[closest_time].iloc[0]
        else:
            # If target time is before all observed times, use the first available probability
            survival_prob = survival_func.iloc[0, 0]
    
    survival_probs.append(survival_prob)
    patient_ids.append(patient_id)
    shrinkage_groups.append(shrinkage_group)

print(f"Predicted survival probabilities for first 10 patients:")
for i in range(10):
    print(f"Patient {patient_ids[i]}: ShrinkageGroup={shrinkage_groups[i]}, Survival_Prob={survival_probs[i]:.6f}")

print(f"\nSummary of predicted survival probabilities:")
print(f"Mean: {np.mean(survival_probs):.6f}")
print(f"Std: {np.std(survival_probs):.6f}")
print(f"Min: {np.min(survival_probs):.6f}")
print(f"Max: {np.max(survival_probs):.6f}")
</execute>
