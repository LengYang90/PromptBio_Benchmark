# Prepare data for Cox model
# lifelines expects duration, event, and covariates
cox_data = df[['SurvTime', 'Event', 'ShrinkageGroup']].copy()

print("Data for Cox model:")
print(cox_data.head())
print(f"\nData shape: {cox_data.shape}")

# Fit Cox Proportional Hazards model
cph = CoxPHFitter()
cph.fit(cox_data, duration_col='SurvTime', event_col='Event')

print("\nCox Model Summary:")
cph.print_summary()

print(f"\nModel coefficients:")
print(cph.params_)

print(f"\nHazard ratios:")
print(cph.hazard_ratios_)
</execute>
