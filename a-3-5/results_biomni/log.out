# Generate rMATS format output files
def generate_rmats_output(splicing_events, output_dir, junction_data):
    """Generate rMATS format output files"""
    
    # Create output directory if it doesn't exist
    os.makedirs(output_dir, exist_ok=True)
    
    # Generate junction counts (simplified)
    def get_junction_counts(event, sample_junctions):
        # Simplified junction counting - in real rMATS this would be more sophisticated
        inclusion_count = 10  # Simulated inclusion junction count
        skipping_count = 5    # Simulated skipping junction count
        return inclusion_count, skipping_count
    
    # Generate SE (Skipped Exon) output
    if splicing_events['SE']:
        se_output_file = os.path.join(output_dir, "SE.MATS.JC.txt")
        
        # Create header
        header = [
            "ID", "GeneID", "geneSymbol", "chr", "strand", 
            "exonStart_0base", "exonEnd", "upstreamES", "upstreamEE",
            "downstreamES", "downstreamEE", "longExonStart_0base", "longExonEnd",
            "shortES", "shortEE", "ID", "IJC_SAMPLE_1", "SJC_SAMPLE_1",
            "IJC_SAMPLE_2", "SJC_SAMPLE_2", "IncFormLen", "SkipFormLen"
        ]
        
        # Prepare data
        se_data = []
        for i, event in enumerate(splicing_events['SE']):
            # Get junction counts for each sample
            ijc_sample1, sjc_sample1 = get_junction_counts(event, all_junctions['sample_1'])
            ijc_sample2, sjc_sample2 = get_junction_counts(event, all_junctions['sample_2'])
            
            # Calculate form lengths (simplified)
            inc_form_len = 150  # Inclusion form length
            skip_form_len = 100 # Skip form length
            
            row = [
                event['ID'], event['GeneID'], event['geneSymbol'], 
                event['chr'], event['strand'],
                event['exonStart_0base'], event['exonEnd'],
                event['upstreamES'], event['upstreamEE'],
                event['downstreamES'], event['downstreamEE'],
                event['longExonStart_0base'], event['longExonEnd'],
                event['shortES'], event['shortEE'],
                event['ID'],
                ijc_sample1, sjc_sample1, ijc_sample2, sjc_sample2,
                inc_form_len, skip_form_len
            ]
            se_data.append(row)
        
        # Write to file
        with open(se_output_file, 'w') as f:
            f.write('\t'.join(header) + '\n')
            for row in se_data:
                f.write('\t'.join(map(str, row)) + '\n')
        
        print(f"✓ Generated {se_output_file}")
        
        # Show first few lines
        print("\nFirst few lines of SE.MATS.JC.txt:")
        with open(se_output_file, 'r') as f:
            lines = f.readlines()
            for i, line in enumerate(lines[:3]):
                print(f"  {i+1}: {line.strip()}")
    
    # Generate empty files for other event types (MXE, A3SS, A5SS, RI)
    for event_type in ['MXE', 'A3SS', 'A5SS', 'RI']:
        output_file = os.path.join(output_dir, f"{event_type}.MATS.JC.txt")
        
        # Create appropriate headers for each event type
        if event_type == 'MXE':
            header = ["ID", "GeneID", "geneSymbol", "chr", "strand", 
                     "1stExonStart_0base", "1stExonEnd", "2ndExonStart_0base", "2ndExonEnd",
                     "upstreamES", "upstreamEE", "downstreamES", "downstreamEE",
                     "ID", "IJC_SAMPLE_1", "SJC_SAMPLE_1", "IJC_SAMPLE_2", "SJC_SAMPLE_2",
                     "IncFormLen", "SkipFormLen"]
        elif event_type in ['A3SS', 'A5SS']:
            header = ["ID", "GeneID", "geneSymbol", "chr", "strand",
                     "longExonStart_0base", "longExonEnd", "shortES", "shortEE",
                     "flankingES", "flankingEE",
                     "ID", "IJC_SAMPLE_1", "SJC_SAMPLE_1", "IJC_SAMPLE_2", "SJC_SAMPLE_2",
                     "IncFormLen", "SkipFormLen"]
        else:  # RI
            header = ["ID", "GeneID", "geneSymbol", "chr", "strand",
                     "riExonStart_0base", "riExonEnd", "upstreamES", "upstreamEE",
                     "downstreamES", "downstreamEE",
                     "ID", "IJC_SAMPLE_1", "SJC_SAMPLE_1", "IJC_SAMPLE_2", "SJC_SAMPLE_2",
                     "IncFormLen", "SkipFormLen"]
        
        with open(output_file, 'w') as f:
            f.write('\t'.join(header) + '\n')
        
        print(f"✓ Generated {output_file} (empty)")

# Generate output files
