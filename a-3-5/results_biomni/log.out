    result = subprocess.run(['rmats.py', '--help'], capture_output=True, text=True, timeout=10)
    if result.returncode == 0:
        print("✓ rMATS is available")
        print("rMATS help output (first few lines):")
        help_lines = result.stdout.split('\n')[:10]
        for line in help_lines:
            print(f"  {line}")
    else:
