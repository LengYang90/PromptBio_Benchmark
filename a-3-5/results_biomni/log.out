<execute>
import os
import subprocess
import sys

# Install the rmatspipeline module
print("Installing rmatspipeline module...")
os.chdir("/tmp/rmats-turbo/rMATS_pipeline")

try:
    # Install the pipeline module
    result = subprocess.run([sys.executable, "setup.py", "install"], 
                          capture_output=True, text=True, timeout=120)
    
    print(f"Installation return code: {result.returncode}")
    if result.stdout:
        print(f"stdout: {result.stdout}")
    if result.stderr:
        print(f"stderr: {result.stderr}")
    
    if result.returncode == 0:
        print("✓ rmatspipeline installed successfully")
        
        # Now test rMATS
        os.chdir("/tmp/rmats-turbo")
        print("\nTesting rMATS after pipeline installation...")
        result = subprocess.run([sys.executable, "rmats.py", "--help"], 
                              capture_output=True, text=True, timeout=30)
        
        if result.returncode == 0:
            print("✓ rMATS is now working!")
            print("Help output (first 15 lines):")
            for line in result.stdout.split('\n')[:15]:
                print(f"  {line}")
        else:
            print(f"✗ rMATS still failing: {result.stderr}")
    else:
        print("✗ Pipeline installation failed")
        
except Exception as e:
    print(f"Error during installation: {e}")
</execute>
