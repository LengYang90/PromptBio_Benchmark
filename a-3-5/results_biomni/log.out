<execute>
# Create alternative splicing detection and rMATS format output
def detect_splicing_events(transcripts, junction_data):
    """Detect different types of alternative splicing events"""
    
    # Group transcripts by gene
    gene_transcripts = defaultdict(list)
    for transcript_id, exons in transcripts.items():
        if exons:
            gene_id = exons[0]['gene_id']
            gene_transcripts[gene_id].append((transcript_id, exons))
    
    splicing_events = {
        'SE': [],  # Skipped Exon
        'MXE': [], # Mutually Exclusive Exons
        'A3SS': [], # Alternative 3' Splice Site
        'A5SS': [], # Alternative 5' Splice Site
        'RI': []   # Retained Intron
    }
    
    # Analyze each gene for splicing events
    for gene_id, transcript_list in gene_transcripts.items():
        if len(transcript_list) > 1:
            print(f"Analyzing gene {gene_id} with {len(transcript_list)} transcripts")
            
            # Compare transcripts to find splicing events
            for i in range(len(transcript_list)):
                for j in range(i+1, len(transcript_list)):
                    transcript1_id, exons1 = transcript_list[i]
                    transcript2_id, exons2 = transcript_list[j]
                    
                    # Find skipped exons
                    exon_coords1 = [(e['start'], e['end']) for e in exons1]
                    exon_coords2 = [(e['start'], e['end']) for e in exons2]
                    
                    # Simple skipped exon detection
                    if len(exon_coords1) != len(exon_coords2):
                        longer_transcript = transcript1_id if len(exons1) > len(exons2) else transcript2_id
                        shorter_transcript = transcript2_id if len(exons1) > len(exons2) else transcript1_id
                        longer_exons = exons1 if len(exons1) > len(exons2) else exons2
                        shorter_exons = exons2 if len(exons1) > len(exons2) else exons1
                        
                        # Find the skipped exon(s)
                        longer_coords = set((e['start'], e['end']) for e in longer_exons)
                        shorter_coords = set((e['start'], e['end']) for e in shorter_exons)
                        skipped_exons = longer_coords - shorter_coords
                        
                        for skipped_start, skipped_end in skipped_exons:
                            # Create skipped exon event
                            chrom = longer_exons[0]['chrom']
                            strand = longer_exons[0]['strand']
                            
                            # Find flanking exons
                            upstream_exon = None
                            downstream_exon = None
                            
                            for exon in longer_exons:
                                if exon['end'] < skipped_start:
                                    upstream_exon = exon
                                elif exon['start'] > skipped_end and downstream_exon is None:
                                    downstream_exon = exon
                                    break
                            
                            if upstream_exon and downstream_exon:
                                se_event = {
                                    'ID': f"SE_{len(splicing_events['SE'])+1}",
                                    'GeneID': gene_id,
                                    'geneSymbol': gene_id,
                                    'chr': chrom,
                                    'strand': strand,
                                    'exonStart_0base': skipped_start - 1,
                                    'exonEnd': skipped_end,
                                    'upstreamES': upstream_exon['end'],
                                    'upstreamEE': upstream_exon['end'],
                                    'downstreamES': downstream_exon['start'],
                                    'downstreamEE': downstream_exon['end'],
                                    'longExonStart_0base': upstream_exon['start'] - 1,
                                    'longExonEnd': downstream_exon['end'],
                                    'shortES': upstream_exon['end'],
                                    'shortEE': downstream_exon['start']
                                }
                                splicing_events['SE'].append(se_event)
                                print(f"  Found skipped exon: {chrom}:{skipped_start}-{skipped_end}")
    
    return splicing_events

# Detect splicing events
splicing_events = detect_splicing_events(transcripts, all_junctions)

print(f"\nDetected splicing events:")
for event_type, events in splicing_events.items():
    print(f"  {event_type}: {len(events)} events")
</execute>
