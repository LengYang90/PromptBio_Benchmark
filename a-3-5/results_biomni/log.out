import sys
import os

# Add rMATS directory to Python path
rmats_path = "/tmp/rmats-turbo"
if rmats_path not in sys.path:
    sys.path.insert(0, rmats_path)

# Try to import rMATS modules
try:
    os.chdir(rmats_path)
    
    # Check what Python modules are available
    print("Available Python files in rMATS directory:")
    for file in os.listdir("."):
        if file.endswith(".py"):
            print(f"  {file}")
    
    # Check rMATS_pipeline directory
    if os.path.exists("rMATS_pipeline"):
        print("\nAvailable files in rMATS_pipeline:")
        for file in os.listdir("rMATS_pipeline"):
            print(f"  {file}")
    
    # Try to run rMATS directly with sys.executable
    print("\nTrying to run rMATS...")
    result = subprocess.run([sys.executable, "rmats.py", "--help"], 
                          capture_output=True, text=True, timeout=30,
                          env=dict(os.environ, PYTHONPATH=rmats_path))
    
    if result.returncode == 0:
        print("✓ rMATS is working!")
        print("Help output (first 10 lines):")
        for line in result.stdout.split('\n')[:10]:
            print(f"  {line}")
    else:
        print(f"✗ rMATS failed: {result.stderr}")
        
except Exception as e:
    print(f"Error: {e}")
</execute>
