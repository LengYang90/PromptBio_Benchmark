#!BASH
cd /tmp/rmats-turbo

echo "Building rMATS..."
# Check if build script exists and run it
if [ -f "build_rmats" ]; then
    echo "Running build_rmats script..."
    chmod +x build_rmats
    ./build_rmats
else
    echo "No build_rmats script found"
fi

# Check if rmats.py is executable
if [ -f "rmats.py" ]; then
    echo "Making rmats.py executable..."
    chmod +x rmats.py
    
    # Test if it works
    echo "Testing rMATS..."
    python rmats.py --help | head -10
    
    # Copy to a location in PATH
    echo "Copying rMATS to /usr/local/bin..."
    cp rmats.py /usr/local/bin/
    
    # Also copy the entire directory to preserve dependencies
    cp -r /tmp/rmats-turbo /opt/rmats-turbo
    
    # Create a symlink
    ln -sf /opt/rmats-turbo/rmats.py /usr/local/bin/rmats.py
    
    echo "rMATS installation completed"
else
    echo "rmats.py not found"
fi
