<execute>
# Let's create a custom alternative splicing detection script
import pandas as pd
import subprocess
import os
from collections import defaultdict

# First, let's examine the BAM files more closely to understand the data
print("Analyzing BAM files for splicing junctions...")

def analyze_bam_for_junctions(bam_file):
    """Extract splicing junctions from BAM file"""
    junctions = []
    
    try:
        # Use samtools to extract alignments with CIGAR strings containing 'N' (introns)
        result = subprocess.run(['samtools', 'view', bam_file], 
                              capture_output=True, text=True, timeout=60)
        
        if result.returncode == 0:
            lines = result.stdout.strip().split('\n')
            print(f"Found {len(lines)} alignments in {bam_file}")
            
            for line in lines:
                if line.strip():
                    fields = line.split('\t')
                    if len(fields) >= 6:
                        chrom = fields[2]
                        pos = int(fields[3])
                        cigar = fields[5]
                        
                        # Look for 'N' in CIGAR (splice junctions)
                        if 'N' in cigar:
                            junctions.append({
                                'chrom': chrom,
                                'start': pos,
                                'cigar': cigar,
                                'read_id': fields[0]
                            })
            
            print(f"Found {len(junctions)} potential splice junctions")
            return junctions
        else:
            print(f"Error reading {bam_file}: {result.stderr}")
            return []
            
    except Exception as e:
        print(f"Error analyzing {bam_file}: {e}")
        return []

# Analyze both BAM files
bam_files = [
    "/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-3-5/result_2/biomni_20260429/data/sample_1.bam",
    "/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-3-5/result_2/biomni_20260429/data/sample_2.bam"
]

all_junctions = {}
for bam_file in bam_files:
    sample_name = os.path.basename(bam_file).replace('.bam', '')
    all_junctions[sample_name] = analyze_bam_for_junctions(bam_file)
