<execute>
#!BASH
# Try to install rMATS from source
echo "Attempting to install rMATS from source..."

# First check if git is available
which git
if [ $? -eq 0 ]; then
    echo "Git is available"
    
    # Create a temporary directory for installation
    cd /tmp
    
    # Clone rMATS repository
    echo "Cloning rMATS repository..."
    git clone https://github.com/Xinglab/rmats-turbo.git
    
    if [ $? -eq 0 ]; then
        echo "Repository cloned successfully"
        cd rmats-turbo
        
        # Check if there's a setup.py or installation instructions
        ls -la
        
        # Try to install
        if [ -f "setup.py" ]; then
            echo "Found setup.py, attempting installation..."
            python setup.py install
        elif [ -f "requirements.txt" ]; then
            echo "Found requirements.txt, installing dependencies..."
            pip install -r requirements.txt
        fi
    else
        echo "Failed to clone repository"
    fi
else
    echo "Git not available"
fi
</execute>
