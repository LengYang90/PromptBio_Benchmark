# Parse GTF file to understand gene structure
def parse_gtf(gtf_file):
    """Parse GTF file to extract gene and exon information"""
    genes = defaultdict(list)
    transcripts = defaultdict(list)
    
    with open(gtf_file, 'r') as f:
        for line in f:
            if line.startswith('#'):
                continue
            
            fields = line.strip().split('\t')
            if len(fields) >= 9:
                chrom = fields[0]
                feature = fields[2]
                start = int(fields[3])
                end = int(fields[4])
                strand = fields[6]
                attributes = fields[8]
                
                # Parse attributes
                attr_dict = {}
                for attr in attributes.split(';'):
                    if attr.strip():
                        parts = attr.strip().split(' ', 1)
                        if len(parts) == 2:
                            key = parts[0]
                            value = parts[1].strip('"')
                            attr_dict[key] = value
                
                if feature == 'exon':
                    transcript_id = attr_dict.get('transcript_id', '')
                    gene_id = attr_dict.get('gene_id', '')
                    
                    transcripts[transcript_id].append({
                        'chrom': chrom,
                        'start': start,
                        'end': end,
                        'strand': strand,
                        'gene_id': gene_id
                    })
    
    return dict(transcripts)

# Parse the GTF file
gtf_file = "/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-3-5/result_2/biomni_20260429/data/annotation.gtf"
transcripts = parse_gtf(gtf_file)

print("Parsed transcripts:")
for transcript_id, exons in transcripts.items():
    print(f"  {transcript_id}: {len(exons)} exons")
    for i, exon in enumerate(exons):
        print(f"    Exon {i+1}: {exon['chrom']}:{exon['start']}-{exon['end']}")
</execute>
