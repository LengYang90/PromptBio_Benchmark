3. [✓] Configure search parameters for the peptide identification

Now let me implement a basic scoring function and perform peptide-spectrum matching:

<execute>
# Implement basic peptide-spectrum matching
print("Starting peptide-spectrum matching...")

def calculate_theoretical_mz(peptide, charge):
    """Calculate theoretical m/z for a peptide"""
    try:
        peptide_mass = mass.calculate_mass(peptide, ion_type='M')
        return (peptide_mass + charge * mass.PROTON) / charge
    except:
        return 0

def simple_score(theoretical_peaks, observed_peaks, tolerance=0.5):
    """Simple scoring function based on peak matching"""
    if len(theoretical_peaks) == 0 or len(observed_peaks) == 0:
        return 0
    
    matches = 0
    observed_mz = observed_peaks[:, 0] if len(observed_peaks.shape) > 1 else observed_peaks
    
    for theo_mz in theoretical_peaks:
        # Find closest peak within tolerance
        diffs = np.abs(observed_mz - theo_mz)
        if np.min(diffs) <= tolerance:
            matches += 1
    
    # Normalize by theoretical peaks
    return matches / len(theoretical_peaks) if len(theoretical_peaks) > 0 else 0

def generate_theoretical_peaks(peptide, charge):
    """Generate simple theoretical fragment ions (b and y ions)"""
    peaks = []
    
    try:
        # Generate b ions
        for i in range(1, len(peptide)):
            fragment = peptide[:i]
            b_mass = mass.calculate_mass(fragment, ion_type='M')
            for frag_charge in range(1, min(charge, 3) + 1):
                b_mz = (b_mass + frag_charge * mass.PROTON) / frag_charge
                peaks.append(b_mz)
        
        # Generate y ions
        for i in range(1, len(peptide)):
            fragment = peptide[i:]
            y_mass = mass.calculate_mass(fragment, ion_type='M')
            for frag_charge in range(1, min(charge, 3) + 1):
                y_mz = (y_mass + frag_charge * mass.PROTON) / frag_charge
                peaks.append(y_mz)
                
    except Exception as e:
        print(f"Error generating peaks for {peptide}: {e}")
        
    return peaks

# Perform peptide identification
psms = []
processed_spectra = 0

print("Matching spectra to peptides...")

for spectrum in ms2_spectra:
    processed_spectra += 1
    if processed_spectra % 10 == 0:
        print(f"Processed {processed_spectra}/{len(ms2_spectra)} spectra")
    
    precursor_mz = spectrum['precursor_mz']
    charge = spectrum['charge'] if spectrum['charge'] > 0 else 2  # Default charge
    observed_peaks = spectrum['peaks']
    
    if len(observed_peaks) == 0:
        continue
    
    best_score = 0
    best_peptide = None
    best_proteins = []
    
    # Test peptides that match precursor mass
    for peptide, protein_list in theoretical_peptides.items():
        theoretical_mz = calculate_theoretical_mz(peptide, charge)
        
        if theoretical_mz == 0:
            continue
            
        # Check precursor mass tolerance (20 ppm)
        ppm_error = abs(theoretical_mz - precursor_mz) / precursor_mz * 1e6
        if ppm_error <= 20:
            
            # Generate theoretical fragment peaks
            theoretical_peaks = generate_theoretical_peaks(peptide, charge)
            
            # Calculate score
            score = simple_score(theoretical_peaks, observed_peaks)
            
            if score > best_score:
                best_score = score
                best_peptide = peptide
                best_proteins = protein_list
    
    # Store PSM if we found a match
    if best_peptide and best_score > 0.1:  # Minimum score threshold
        psm = {
            'spectrum_id': spectrum['id'],
            'peptide_sequence': best_peptide,
            'charge': charge,
            'protein_accession': best_proteins[0] if best_proteins else 'Unknown',
            'score': best_score,
            'precursor_mz': precursor_mz,
            'theoretical_mz': calculate_theoretical_mz(best_peptide, charge)
        }
        psms.append(psm)

print(f"Found {len(psms)} peptide-spectrum matches")
</execute>
