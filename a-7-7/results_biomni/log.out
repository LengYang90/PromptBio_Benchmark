<execute>
# Import necessary libraries
import pymzml
from pyteomics import fasta, mass
import numpy as np
import pandas as pd
from collections import defaultdict
import re

print("Starting peptide identification workflow...")

# First, let's load and examine the mzML file
print("Loading mzML file...")
run = pymzml.run.Reader(mzml_file)

# Count spectra and examine structure
ms2_spectra = []
spectrum_count = 0

print("Scanning mzML file for MS2 spectra...")
for spectrum in run:
    spectrum_count += 1
    if spectrum_count % 1000 == 0:
        print(f"Processed {spectrum_count} spectra...")
    
    # Look for MS2 spectra
    if spectrum.ms_level == 2:
        spectrum_info = {
            'id': spectrum['id'],
            'scan_number': spectrum.get('scan start time', spectrum_count),
            'precursor_mz': spectrum.get('selected ion m/z', 0),
            'charge': spectrum.get('charge state', 0),
            'peaks': spectrum.peaks('centroided'),
            'retention_time': spectrum.get('scan start time', 0)
        }
        ms2_spectra.append(spectrum_info)
    
    # Limit for testing - remove this for full analysis
    if len(ms2_spectra) >= 100:  # Process first 100 MS2 spectra for testing
        break

print(f"Found {len(ms2_spectra)} MS2 spectra for identification")
print(f"Total spectra processed: {spectrum_count}")
</execute>
