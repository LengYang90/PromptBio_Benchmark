                        'peptide_sequence': peptide,
                        'charge': test_charge,
                        'protein_accession': protein_list[0] if protein_list else 'Unknown',
                        'score': 1.0 - (mass_error / 1.0),  # Simple score
                        'precursor_mz': precursor_mz,
                        'mass_error': mass_error
                    }
                    psms_lenient.append(psm)
                    break
            except:
