<execute>
# Load protein database and generate theoretical peptides
print("Loading FASTA database...")

proteins = {}
protein_count = 0

# Parse FASTA file
for description, sequence in fasta.read(fasta_file):
    protein_count += 1
    if protein_count % 1000 == 0:
        print(f"Loaded {protein_count} proteins...")
    
    # Extract protein accession from description
    # Format: >sp|A9F596|ACCA_SORC5 ...
    match = re.search(r'>sp\|([^|]+)\|([^|\s]+)', description)
    if match:
        accession = match.group(1)
        proteins[accession] = {
            'sequence': sequence,
            'description': description
        }
    else:
        # Handle other formats or decoy sequences
        parts = description.split()
        if len(parts) > 0:
            accession = parts[0].replace('>', '')
            proteins[accession] = {
                'sequence': sequence,
                'description': description
            }

print(f"Loaded {len(proteins)} proteins from FASTA database")

# Generate theoretical peptides (tryptic digestion)
print("Generating theoretical peptides...")
theoretical_peptides = {}
peptide_count = 0

def tryptic_digest(sequence, missed_cleavages=2):
    """Simple tryptic digestion"""
    # Trypsin cleaves after K and R, except when followed by P
    peptides = []
    
    # Split by tryptic sites
    pattern = r'(?<=[KR])(?!P)'
    fragments = re.split(pattern, sequence)
    
    # Generate peptides with missed cleavages
    for i in range(len(fragments)):
        for j in range(i, min(i + missed_cleavages + 2, len(fragments))):
            peptide = ''.join(fragments[i:j+1])
            if 6 <= len(peptide) <= 50:  # Reasonable peptide length
                peptides.append(peptide)
    
    return peptides

# Generate peptides for a subset of proteins (for testing)
protein_subset = list(proteins.keys())[:100]  # Use first 100 proteins for testing

for accession in protein_subset:
    peptides = tryptic_digest(proteins[accession]['sequence'])
    for peptide in peptides:
        if peptide not in theoretical_peptides:
            theoretical_peptides[peptide] = []
        theoretical_peptides[peptide].append(accession)
        peptide_count += 1

print(f"Generated {len(theoretical_peptides)} unique theoretical peptides")
print(f"Total peptide instances: {peptide_count}")
</execute>
