             # Column mapping for Comet TXT output:
             # scan(1), num(2), charge(3), exp_neutral_mass(4), calc_neutral_mass(5), 
             # e_value(6), xcorr(7), delta_cn(8), sp_score(9), ions(10), matched_ions(11), 
