        echo "- Unique peptides: $(tail -n +2 BSA2_F1_comet_psm.tsv | cut -f2 | sort -u | wc -l)"
        echo "- Unique proteins: $(tail -n +2 BSA2_F1_comet_psm.tsv | cut -f4 | sort -u | wc -l)"
    else
        echo "⚠ Warning: No PSMs found in output file"
    fi
else
