# Check Comet installation and run database search with error handling
cd /mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-7-7/result_10/toolsgenie_20260516

echo "=== Checking Comet Installation ==="
which comet
if [ $? -ne 0 ]; then
    echo "Comet not found in PATH. Attempting to install..."
    
    # Try to install Comet via conda if available
    if command -v conda &> /dev/null; then
        conda install -c bioconda comet-ms -y
    elif command -v apt-get &> /dev/null; then
        # Try apt-get for Ubuntu/Debian systems
        sudo apt-get update
        sudo apt-get install -y comet-ms
    else
        echo "Package manager not found. Please install Comet manually."
        echo "Visit: https://uwpr.github.io/Comet/ for installation instructions"
        exit 1
    fi
fi

echo ""
echo "=== Verifying Input Files ==="
if [ ! -f "/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-7-7/result_10/toolsgenie_20260516/data/BSA2_F1.mzML" ]; then
    echo "Error: Input mzML file not found!"
    exit 1
fi

if [ ! -f "/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-7-7/result_10/toolsgenie_20260516/comet.params" ]; then
    echo "Error: Parameter file not found!"
    exit 1
fi

echo "Input files verified successfully."

echo ""
echo "=== Running Comet Database Search ==="
# Run Comet with verbose output and error capture
comet -P/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-7-7/result_10/toolsgenie_20260516/comet.params /mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-7-7/result_10/toolsgenie_20260516/data/BSA2_F1.mzML 2>&1

# Check if comet command was successful
if [ $? -ne 0 ]; then
    echo "Error: Comet execution failed!"
    exit 1
fi

echo ""
echo "=== Checking Generated Output Files ==="
ls -la BSA2_F1.* 2>/dev/null

echo ""
echo "=== Output File Summary ==="
output_found=false

if [ -f "BSA2_F1.txt" ]; then
    echo "TXT file: $(wc -l < BSA2_F1.txt) lines"
    output_found=true
fi

if [ -f "BSA2_F1.pep.xml" ]; then
