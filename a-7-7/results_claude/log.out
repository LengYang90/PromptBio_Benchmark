                                    clean_peptide = peptide.strip('ABCDEFGHIJKLMNOPQRSTUVWXYZ.')
                                    if not clean_peptide:
                                        clean_peptide = ''.join(c for c in peptide if c.isalpha())
                                    
                                    f.write(f'{spectrum_id}\t{clean_peptide}\t{charge}\t{protein}\n')
                                break
                        break
    print('PSMs extracted from pepXML successfully')
except Exception as e:
    print(f'Error processing pepXML: {e}')
    sys.exit(1)
"
elif [ -f "BSA2_F1.pin" ]; then
    echo "Processing Comet Percolator output..."
    # Extract from PIN format (tab-separated)
    awk 'BEGIN{OFS="\t"; print "spectrum_id", "peptide_sequence", "charge", "protein_accession"} 
         NR>1 && NF>3 {
             split($1, spec_parts, ".");
             spectrum_id = spec_parts[2];
             peptide = $4;
             gsub(/[^A-Z]/, "", peptide);
             charge = $3;
             proteins = $NF;
             split(proteins, prot_array, ",");
             print spectrum_id, peptide, charge, prot_array[1];
         }' BSA2_F1.pin > BSA2_F1_comet_psm.tsv
else
    echo "No recognized Comet output files found. Checking work directory:"
    if [ -d "work" ]; then
        echo "Checking work directory contents:"
        ls -la work/
        find work/ -name "*BSA2_F1*" -type f
    fi
    
