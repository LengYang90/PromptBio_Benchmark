<execute>
# Step 8: Perform joint analysis integrating both RNA and ATAC modalities
print("Step 8: Performing joint analysis of RNA and ATAC data...")

# Create a joint representation by concatenating the reduced dimensions
print("Creating joint representation...")

# Ensure both datasets have the same cells in the same order
common_cells = adata_rna_hvg.obs_names.intersection(adata_atac_filtered.obs_names)
print(f"Common cells: {len(common_cells)}")

# Get the reduced representations
rna_pca = adata_rna_hvg[common_cells].obsm['X_pca'][:, :30]  # Use first 30 PCs
atac_lsi = adata_atac_filtered[common_cells].obsm['X_lsi'][:, :30]  # Use first 30 LSI components

print(f"RNA PCA shape: {rna_pca.shape}")
print(f"ATAC LSI shape: {atac_lsi.shape}")

# Concatenate the representations
joint_representation = np.concatenate([rna_pca, atac_lsi], axis=1)
print(f"Joint representation shape: {joint_representation.shape}")

# Create a new AnnData object for joint analysis
adata_joint = sc.AnnData(X=np.zeros((len(common_cells), 1)))  # Dummy X matrix
adata_joint.obs_names = common_cells
adata_joint.obsm['X_joint'] = joint_representation

# Compute neighbors and UMAP for joint data
print("Computing joint UMAP...")
sc.pp.neighbors(adata_joint, use_rep='X_joint', n_neighbors=15)
sc.tl.umap(adata_joint)

# Perform clustering on joint data
sc.tl.leiden(adata_joint, resolution=0.5)

print(f"Joint clustering results: {adata_joint.obs['leiden'].value_counts().sort_index()}")

print("\nStep 8 completed: Joint analysis performed")
