# Step 2: Load and examine the RNA expression data from the h5 file
print("Step 2: Loading RNA expression data...")

import scanpy as sc
import h5py

# Load the filtered feature matrix (RNA data)
rna_file = "/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-15-8/result_10/biomni_20260516/data/pbmc_granulocyte_sorted_10k_filtered_feature_bc_matrix.h5"

# Read the RNA data using scanpy
adata_rna = sc.read_10x_h5(rna_file)
adata_rna.var_names_unique()

print(f"RNA data shape: {adata_rna.shape}")
print(f"Number of cells: {adata_rna.n_obs}")
print(f"Number of genes: {adata_rna.n_vars}")
print(f"First 5 cell barcodes: {adata_rna.obs_names[:5].tolist()}")
print(f"First 5 genes: {adata_rna.var_names[:5].tolist()}")

# Check the structure of the h5 file to understand the data organization
with h5py.File(rna_file, 'r') as f:
    print("\nH5 file structure:")
    def print_structure(name, obj):
        print(f"  {name}: {type(obj)}")
        if isinstance(obj, h5py.Dataset):
            print(f"    Shape: {obj.shape}, dtype: {obj.dtype}")
    f.visititems(print_structure)

print("\nStep 2 completed: RNA data loaded")
