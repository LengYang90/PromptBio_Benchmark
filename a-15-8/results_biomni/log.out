# Step 4: Load and separate RNA and ATAC data (correct sparse matrix construction)
print("Step 4: Loading and separating RNA and ATAC modalities...")

import scipy.sparse as sp
import pandas as pd

# Load the full multi-modal data manually
with h5py.File(rna_file, 'r') as f:
    # Get the sparse matrix components
    data = f['matrix/data'][:]
    indices = f['matrix/indices'][:]
    indptr = f['matrix/indptr'][:]
    shape = f['matrix/shape'][:]
    
    # Get feature information
    feature_types = [ft.decode('utf-8') for ft in f['matrix/features/feature_type'][:]]
    feature_names = [fn.decode('utf-8') for fn in f['matrix/features/name'][:]]
    feature_ids = [fi.decode('utf-8') for fi in f['matrix/features/id'][:]]
    
    # Get cell barcodes
    barcodes = [bc.decode('utf-8') for bc in f['matrix/barcodes'][:]]

print(f"Matrix shape from file: {shape}")
print(f"Data length: {len(data)}")
print(f"Indices length: {len(indices)}")
print(f"Indptr length: {len(indptr)}")
print(f"Number of features: {len(feature_types)}")
print(f"Number of cells: {len(barcodes)}")

# The matrix is stored as (features x cells) in CSC format
# Create the full sparse matrix correctly
matrix = sp.csc_matrix((data, indices, indptr), shape=(shape[0], shape[1]))

print(f"Created matrix shape: {matrix.shape}")

# Create feature dataframe
feature_df = pd.DataFrame({
    'feature_type': feature_types,
    'feature_name': feature_names,
    'feature_id': feature_ids
})

print(f"Feature types: {feature_df['feature_type'].value_counts()}")

# Get indices for RNA and ATAC features
rna_idx = np.where(np.array(feature_types) == 'Gene Expression')[0]
atac_idx = np.where(np.array(feature_types) == 'Peaks')[0]

print(f"RNA feature indices: {len(rna_idx)} (range: {rna_idx[0]}-{rna_idx[-1]})")
print(f"ATAC feature indices: {len(atac_idx)} (range: {atac_idx[0]}-{atac_idx[-1]})")

# Extract submatrices (features x cells) and transpose to get (cells x features)
rna_matrix = matrix[rna_idx, :].T
atac_matrix = matrix[atac_idx, :].T

print(f"RNA matrix shape (cells x genes): {rna_matrix.shape}")
print(f"ATAC matrix shape (cells x peaks): {atac_matrix.shape}")

# Create AnnData objects
adata_rna = sc.AnnData(X=rna_matrix)
adata_rna.obs_names = barcodes
adata_rna.var_names = [feature_names[i] for i in rna_idx]

adata_atac = sc.AnnData(X=atac_matrix)
adata_atac.obs_names = barcodes
adata_atac.var_names = [feature_names[i] for i in atac_idx]

print(f"RNA genes (first 5): {adata_rna.var_names[:5]}")
print(f"ATAC peaks (first 5): {adata_atac.var_names[:5]}")

print("\nStep 4 completed: RNA and ATAC data separated")
</execute>
