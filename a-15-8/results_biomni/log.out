<execute>
# Step 4: Load and separate RNA and ATAC data
print("Step 4: Loading and separating RNA and ATAC modalities...")

import scipy.sparse as sp

# Read the full multi-modal data
adata_full = sc.read_10x_h5(rna_file)

# Get feature information to separate modalities
with h5py.File(rna_file, 'r') as f:
    feature_types = f['matrix/features/feature_type'][:]
    feature_names = f['matrix/features/name'][:]
    feature_ids = f['matrix/features/id'][:]

# Convert bytes to strings
feature_types_str = [ft.decode('utf-8') for ft in feature_types]
feature_names_str = [fn.decode('utf-8') for fn in feature_names]
feature_ids_str = [fi.decode('utf-8') for fi in feature_ids]

# Add feature type information to the full data
adata_full.var['feature_type'] = feature_types_str
adata_full.var['feature_name'] = feature_names_str
adata_full.var['feature_id'] = feature_ids_str

print(f"Full data shape: {adata_full.shape}")
print(f"Feature types: {adata_full.var['feature_type'].value_counts()}")

# Separate RNA and ATAC data
rna_mask = adata_full.var['feature_type'] == 'Gene Expression'
atac_mask = adata_full.var['feature_type'] == 'Peaks'

# Create separate AnnData objects for RNA and ATAC
adata_rna = adata_full[:, rna_mask].copy()
adata_atac = adata_full[:, atac_mask].copy()

print(f"RNA data shape: {adata_rna.shape}")
print(f"ATAC data shape: {adata_atac.shape}")

# Set proper gene names for RNA data
adata_rna.var_names = adata_rna.var['feature_name']
adata_rna.var_names_unique()

# Set proper peak names for ATAC data  
adata_atac.var_names = adata_atac.var['feature_name']
adata_atac.var_names_unique()

print(f"RNA genes (first 5): {adata_rna.var_names[:5].tolist()}")
print(f"ATAC peaks (first 5): {adata_atac.var_names[:5].tolist()}")

print("\nStep 4 completed: RNA and ATAC data separated")
