# Step 3: Examine the multi-modal data structure and separate RNA/ATAC
print("Step 3: Examining multi-modal data structure...")

# Let's look at the features in more detail to understand the data structure
with h5py.File(rna_file, 'r') as f:
    feature_types = f['matrix/features/feature_type'][:]
    feature_names = f['matrix/features/name'][:]
    feature_ids = f['matrix/features/id'][:]
    intervals = f['matrix/features/interval'][:]
    
print(f"Total features in file: {len(feature_types)}")
print(f"Unique feature types: {np.unique(feature_types)}")

# Count features by type
feature_type_counts = {}
for ft in feature_types:
    ft_str = ft.decode('utf-8')
    feature_type_counts[ft_str] = feature_type_counts.get(ft_str, 0) + 1

print("Feature type counts:")
for ft, count in feature_type_counts.items():
    print(f"  {ft}: {count}")

# Check some examples of each feature type
print("\nExample features:")
for ft in np.unique(feature_types):
    ft_str = ft.decode('utf-8')
    indices = np.where(feature_types == ft)[0][:3]
    print(f"\n{ft_str} examples:")
    for idx in indices:
        name = feature_names[idx].decode('utf-8') if feature_names[idx] else "N/A"
        id_val = feature_ids[idx].decode('utf-8') if feature_ids[idx] else "N/A"
        interval = intervals[idx].decode('utf-8') if intervals[idx] else "N/A"
        print(f"  Name: {name}, ID: {id_val}, Interval: {interval}")

print("\nStep 3 completed: Data structure examined")
