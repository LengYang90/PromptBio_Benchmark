# Step 9: Create the final visualization with side-by-side UMAPs
print("Step 9: Creating final visualization with side-by-side UMAPs...")

import matplotlib.pyplot as plt
import matplotlib.patches as mpatches

# Set up the figure with two subplots
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 7))

# Define a color palette for clusters
import matplotlib.cm as cm
import numpy as np

# Get unique clusters for coloring
atac_clusters = adata_atac_filtered.obs['leiden'].astype(int)
joint_clusters = adata_joint.obs['leiden'].astype(int)

# Create color maps
n_atac_clusters = len(atac_clusters.unique())
n_joint_clusters = len(joint_clusters.unique())

# Use different color palettes
atac_colors = cm.tab20(np.linspace(0, 1, n_atac_clusters))
joint_colors = cm.tab20b(np.linspace(0, 1, n_joint_clusters))

# Plot 1: ATAC-only UMAP
print("Creating ATAC-only UMAP plot...")
umap_atac = adata_atac_filtered.obsm['X_umap']

for i, cluster in enumerate(sorted(atac_clusters.unique())):
    mask = atac_clusters == cluster
    ax1.scatter(umap_atac[mask, 0], umap_atac[mask, 1], 
               c=[atac_colors[i]], label=f'ATAC-{cluster}', 
               alpha=0.7, s=8)

ax1.set_title('UMAP: ATAC-seq Only', fontsize=14, fontweight='bold')
ax1.set_xlabel('UMAP1', fontsize=12)
ax1.set_ylabel('UMAP2', fontsize=12)
ax1.grid(True, alpha=0.3)

# Create legend for ATAC plot
atac_legend_elements = [mpatches.Patch(color=atac_colors[i], label=f'Cluster {cluster}') 
                       for i, cluster in enumerate(sorted(atac_clusters.unique()))]
ax1.legend(handles=atac_legend_elements, bbox_to_anchor=(1.05, 1), loc='upper left', fontsize=8)

# Plot 2: Joint RNA+ATAC UMAP
print("Creating joint RNA+ATAC UMAP plot...")
umap_joint = adata_joint.obsm['X_umap']

for i, cluster in enumerate(sorted(joint_clusters.unique())):
    mask = joint_clusters == cluster
    ax2.scatter(umap_joint[mask, 0], umap_joint[mask, 1], 
               c=[joint_colors[i]], label=f'Joint-{cluster}', 
               alpha=0.7, s=8)

ax2.set_title('UMAP: Joint RNA+ATAC', fontsize=14, fontweight='bold')
ax2.set_xlabel('UMAP1', fontsize=12)
ax2.set_ylabel('UMAP2', fontsize=12)
ax2.grid(True, alpha=0.3)

# Create legend for joint plot
joint_legend_elements = [mpatches.Patch(color=joint_colors[i], label=f'Cluster {cluster}') 
                        for i, cluster in enumerate(sorted(joint_clusters.unique()))]
ax2.legend(handles=joint_legend_elements, bbox_to_anchor=(1.05, 1), loc='upper left', fontsize=8)

# Adjust layout to prevent overlap
plt.tight_layout()

# Add overall title
fig.suptitle('Single-Cell Multi-Omic Analysis: ATAC-seq vs Joint RNA+ATAC Integration', 
            fontsize=16, fontweight='bold', y=1.02)

print("Saving plot...")

# Save the figure
output_path = "/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-15-8/result_10/biomni_20260516/umap_multiple.png"
plt.savefig(output_path, dpi=300, bbox_inches='tight', facecolor='white')
plt.show()

print(f"Plot saved to: {output_path}")

# Print summary statistics
print("\nSummary Statistics:")
print(f"Total cells analyzed: {len(common_cells)}")
print(f"RNA genes (after filtering): {adata_rna_hvg.n_vars}")
print(f"ATAC peaks (after filtering): {adata_atac_filtered.n_vars}")
print(f"ATAC-only clusters: {n_atac_clusters}")
print(f"Joint RNA+ATAC clusters: {n_joint_clusters}")

print("\nStep 9 completed: Final visualization created and saved")
