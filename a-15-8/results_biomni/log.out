    install.packages("BiocManager")
}
library(BiocManager)

# Install required packages
packages_to_install <- c("Seurat", "hdf5r", "Matrix", "ggplot2", "patchwork")
for (pkg in packages_to_install) {
    if (!require(pkg, character.only = TRUE, quietly = TRUE)) {
        print(paste("Installing", pkg))
        install.packages(pkg)
    }
}

# Install Bioconductor packages
bioc_packages <- c("Signac", "GenomicRanges", "EnsDb.Hsapiens.v86", "BSgenome.Hsapiens.UCSC.hg38")
for (pkg in bioc_packages) {
    if (!require(pkg, character.only = TRUE, quietly = TRUE)) {
        print(paste("Installing", pkg, "from Bioconductor"))
        BiocManager::install(pkg, update = FALSE)
    }
}

print("Package installation completed")
