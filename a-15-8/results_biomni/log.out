# Basic QC for ATAC data
print("ATAC data basic statistics:")
atac_counts_per_cell = np.array(adata_atac_filtered.X.sum(axis=1)).flatten()
atac_peaks_per_cell = np.array((adata_atac_filtered.X > 0).sum(axis=1)).flatten()

print(f"Total accessibility counts per cell: {atac_counts_per_cell[:10]}")
print(f"Number of accessible peaks per cell: {atac_peaks_per_cell[:10]}")

# Filter peaks - keep peaks accessible in at least 1% of cells
min_cells_per_peak = max(1, int(0.01 * adata_atac_filtered.n_obs))
sc.pp.filter_genes(adata_atac_filtered, min_cells=min_cells_per_peak)

print(f"ATAC peaks after filtering: {adata_atac_filtered.n_vars}")

# Normalize ATAC data using TF-IDF transformation (common for ATAC-seq)
print("Performing TF-IDF normalization for ATAC data...")

# Convert to dense for easier manipulation (since this is a smaller dataset)
X_dense = adata_atac_filtered.X.toarray()

# Calculate term frequency (TF) - normalize by total counts per cell
tf = X_dense / X_dense.sum(axis=1, keepdims=True)
tf = np.nan_to_num(tf)  # Handle division by zero

# Calculate inverse document frequency (IDF)
n_cells = adata_atac_filtered.n_obs
df = (X_dense > 0).sum(axis=0)
idf = np.log(n_cells / (df + 1))  # Add 1 to avoid division by zero

# Apply TF-IDF
tfidf_matrix = tf * idf
adata_atac_filtered.X = sp.csr_matrix(tfidf_matrix)

# Perform dimensionality reduction on ATAC data
print("Performing LSI (Latent Semantic Indexing) for ATAC data...")
from sklearn.decomposition import TruncatedSVD

# LSI is essentially SVD on TF-IDF transformed data
lsi = TruncatedSVD(n_components=50, random_state=42)
atac_lsi = lsi.fit_transform(adata_atac_filtered.X)

# Store LSI results
adata_atac_filtered.obsm['X_lsi'] = atac_lsi
print(f"LSI shape: {atac_lsi.shape}")

# Compute neighbors and UMAP for ATAC data only
sc.pp.neighbors(adata_atac_filtered, use_rep='X_lsi', n_neighbors=15, n_pcs=50)
sc.tl.umap(adata_atac_filtered)

# Perform clustering on ATAC data
sc.tl.leiden(adata_atac_filtered, resolution=0.5)

print(f"ATAC clustering results: {adata_atac_filtered.obs['leiden'].value_counts().sort_index()}")

print("\nStep 6 completed: ATAC data processed and UMAP generated")
