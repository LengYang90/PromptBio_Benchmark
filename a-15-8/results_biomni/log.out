print("Installing leiden algorithm...")
import subprocess
import sys

try:
    subprocess.check_call([sys.executable, "-m", "pip", "install", "leidenalg"])
    print("Leiden algorithm installed successfully")
except:
    print("Installation failed, using louvain clustering instead")

# Continue with ATAC processing
