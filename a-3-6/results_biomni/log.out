<execute>
# Step 5: Create the chimeric junction file and CSV output
print("Step 5: Creating output files...")

# First, let's create a mapping of common genes to chromosomes and positions
# This is a simplified mapping for demonstration
gene_to_chr = {
    'BCR': ('chr22', 23632601, '-'),
    'ABL1': ('chr9', 133729450, '+'),
    'NUP214': ('chr9', 134086816, '+'),
    'XKR3': ('chr22', 17662778, '-'),
    'MT-ND5': ('chrM', 12337, '+'),
    'MT-ND4': ('chrM', 10760, '+'),
    'MT-ND2': ('chrM', 4470, '+'),
    'MT-RNR2': ('chrM', 1671, '+'),
    'MT-ATP6': ('chrM', 8527, '+'),
    'TMPRSS2': ('chr21', 42836478, '+'),
    'ERG': ('chr21', 38675671, '-'),
    'ETV1': ('chr7', 13897379, '+'),
    'EWSR1': ('chr22', 29664364, '-'),
    'FLI1': ('chr11', 128566139, '+'),
    'RUNX1': ('chr21', 36160098, '-'),
    'RUNX1T1': ('chr8', 92017363, '+')
}

# Create chimeric junction data
chimeric_junctions = []
candidate_fusions = []

unique_fusions = {}
for fusion in fusions:
    fusion_key = (fusion['gene1'], fusion['gene2'], fusion['read_name'])
    if fusion_key not in unique_fusions:
        unique_fusions[fusion_key] = fusion

for fusion in unique_fusions.values():
    gene1 = fusion['gene1']
    gene2 = fusion['gene2']
    read_name = fusion['read_name']
    junction_type = fusion['junction_type']
    
    # Get chromosome and position info
    if gene1 in gene_to_chr and gene2 in gene_to_chr:
        chr1, pos1, strand1 = gene_to_chr[gene1]
        chr2, pos2, strand2 = gene_to_chr[gene2]
        
        # Create chimeric junction entry (STAR format)
        # Format: chr1 pos1 strand1 chr2 pos2 strand2 junction_type read_count motif
        chimeric_junction = f"{chr1}\t{pos1}\t{strand1}\t{chr2}\t{pos2}\t{strand2}\t{junction_type}\t1\tGT/AG"
        chimeric_junctions.append(chimeric_junction)
        
        # Create candidate fusion entry
        candidate_fusion = {
            'chr1': chr1,
            'base1': pos1,
            'strand1': strand1,
            'chr2': chr2,
            'base2': pos2,
            'strand2': strand2,
            'junction_type': junction_type,
            'read_name': read_name
        }
        candidate_fusions.append(candidate_fusion)

print(f"Created {len(chimeric_junctions)} chimeric junctions")
print(f"Created {len(candidate_fusions)} candidate fusions")
</execute>
