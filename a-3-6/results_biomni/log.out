# Let's examine the input FASTQ files to understand the data
print("Step 3: Examining input FASTQ files...")

def examine_fastq(filename, num_reads=5):
    print(f"\nExamining {filename}:")
    try:
        with gzip.open(filename, 'rt') as f:
            for i in range(num_reads * 4):  # 4 lines per read
                line = f.readline().strip()
                if i % 4 == 0:
                    print(f"Read {i//4 + 1} header: {line}")
                elif i % 4 == 1:
                    print(f"Sequence: {line[:50]}{'...' if len(line) > 50 else ''}")
                elif i % 4 == 2:
                    print(f"Plus: {line}")
                elif i % 4 == 3:
                    print(f"Quality: {line[:50]}{'...' if len(line) > 50 else ''}")
                    print()
    except Exception as e:
        print(f"Error reading {filename}: {e}")

examine_fastq(input_fq1, 2)
examine_fastq(input_fq2, 2)
</execute>
