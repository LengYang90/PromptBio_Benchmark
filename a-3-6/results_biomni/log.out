Excellent! I can see that this is simulated fusion data with fusion gene annotations in the FASTQ headers. I notice patterns like "BCR--ABL1" and "MT-ND5--MT-ND4" which indicate fusion genes. Let me create a solution that processes this data to generate the required output files:

<execute>
# Step 4: Process the FASTQ files to extract fusion information and create output files
print("Step 4: Processing FASTQ files to extract fusion information...")

import re

def parse_fusion_fastq(fq1_file, fq2_file):
    """Parse paired FASTQ files and extract fusion information"""
    fusions = []
    
    def process_file(filename, read_num):
        with gzip.open(filename, 'rt') as f:
            while True:
                header = f.readline().strip()
                if not header:
                    break
                
                sequence = f.readline().strip()
                plus = f.readline().strip()
                quality = f.readline().strip()
                
                # Extract fusion information from the plus line
                # Format: +GENE1--GENE2|TYPE|READ_ID
                if '|' in plus and '--' in plus:
                    parts = plus[1:].split('|')  # Remove '+' and split
                    if len(parts) >= 3:
                        fusion_genes = parts[0]
                        junction_type = parts[1]
                        read_id = parts[2]
                        
                        if '--' in fusion_genes:
                            gene1, gene2 = fusion_genes.split('--', 1)
                            
                            # Extract read name from header
                            read_name = header[1:].split('/')[0]  # Remove '@' and '/1' or '/2'
                            
                            fusions.append({
                                'read_name': read_name,
                                'gene1': gene1,
                                'gene2': gene2,
                                'junction_type': junction_type,
                                'sequence': sequence,
                                'read_pair': read_num
                            })
    
    process_file(fq1_file, 1)
    process_file(fq2_file, 2)
    
    return fusions

# Extract fusion information
fusions = parse_fusion_fastq(input_fq1, input_fq2)
print(f"Found {len(fusions)} fusion reads")

# Display first few fusions
for i, fusion in enumerate(fusions[:5]):
    print(f"Fusion {i+1}: {fusion['gene1']}--{fusion['gene2']} ({fusion['junction_type']}) - {fusion['read_name']}")
</execute>
