2. [✓] Identify the MTX ligand in the structure

Great! I found MTX ligands in both chains A and B. Now let me find all protein residues within 4.0 Angstroms of each MTX ligand:

<execute>
def calculate_distance(atom1, atom2):
    """Calculate Euclidean distance between two atoms"""
    coord1 = atom1.get_coord()
    coord2 = atom2.get_coord()
    return np.linalg.norm(coord1 - coord2)

def find_binding_residues(structure, distance_cutoff=4.0):
    """Find protein residues within distance_cutoff of MTX ligands"""
    binding_residues = []
    
    for model in structure:
        # First, collect all MTX ligands and protein residues
        mtx_ligands = []
        protein_residues = []
        
        for chain in model:
            for residue in chain:
                if residue.get_resname() == "MTX":
                    mtx_ligands.append((chain.id, residue))
                elif residue.id[0] == " ":  # Standard amino acid residues
                    protein_residues.append((chain.id, residue))
        
        print(f"Found {len(mtx_ligands)} MTX ligands and {len(protein_residues)} protein residues")
        
        # For each protein residue, check distance to all MTX atoms
        for chain_id, protein_res in protein_residues:
            min_distance = float('inf')
            
            for mtx_chain_id, mtx_res in mtx_ligands:
                # Calculate minimum distance between any atoms of protein residue and MTX
                for protein_atom in protein_res:
                    for mtx_atom in mtx_res:
                        distance = calculate_distance(protein_atom, mtx_atom)
                        min_distance = min(min_distance, distance)
            
            # If minimum distance is within cutoff, add to binding residues
            if min_distance <= distance_cutoff:
                binding_residues.append({
                    'Chain': chain_id,
                    'Residue_ID': protein_res.id[1],
                    'Residue_Name': protein_res.get_resname(),
                    'Min_Distance': round(min_distance, 2)
                })
                print(f"  Binding residue: Chain {chain_id}, {protein_res.get_resname()}{protein_res.id[1]}, distance: {min_distance:.2f}Å")
    
    return binding_residues

# Find binding residues
print("Finding protein residues within 4.0Å of MTX ligands...")
binding_residues = find_binding_residues(structure, distance_cutoff=4.0)
print(f"\nTotal binding residues found: {len(binding_residues)}")
</execute>
