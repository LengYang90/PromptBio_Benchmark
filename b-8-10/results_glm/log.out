import pandas as pd
import numpy as np

input_path = '/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/b-8-10/result_79/toolsgenie_20260709/quantile_regression_coefficients_temp.csv'
