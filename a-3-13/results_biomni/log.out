# Analyze the output file
output_file = "/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-3-13/result_2/biomni_20260429/trinity_out.Trinity.fasta"

print("Assembly Statistics:")
print("=" * 40)

if os.path.exists(output_file):
    # Read and analyze transcripts
    transcripts = list(SeqIO.parse(output_file, 'fasta'))
    
    transcript_lengths = [len(transcript.seq) for transcript in transcripts]
    
    print(f"Total number of transcripts: {len(transcripts)}")
    print(f"Total assembled bases: {sum(transcript_lengths):,}")
    print(f"Average transcript length: {sum(transcript_lengths)/len(transcript_lengths):.1f} bp")
    print(f"Minimum transcript length: {min(transcript_lengths)} bp")
    print(f"Maximum transcript length: {max(transcript_lengths)} bp")
    
    # Calculate N50
    sorted_lengths = sorted(transcript_lengths, reverse=True)
    total_length = sum(sorted_lengths)
    cumulative_length = 0
    n50 = 0
    
    for length in sorted_lengths:
        cumulative_length += length
        if cumulative_length >= total_length * 0.5:
            n50 = length
            break
    
    print(f"N50: {n50} bp")
    
    # File verification
    print(f"\nOutput file: {output_file}")
    print(f"File size: {os.path.getsize(output_file):,} bytes")
    print(f"File format: FASTA")
    
    print("\nSample transcript headers:")
    for i, transcript in enumerate(transcripts[:3]):
        print(f"  {transcript.id}: {transcript.description}")
    
    print(f"\n✅ Assembly completed successfully!")
    print(f"✅ Output file generated: trinity_out.Trinity.fasta")
    
else:
    print("❌ Output file not found")
</execute>
