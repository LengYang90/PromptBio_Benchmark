<execute>
import subprocess
import os
import time

print("Plan Update:")
print("1. [✓] Check if Trinity is available and verify input files")
print("2. [✓] Set up the Trinity command with appropriate parameters") 
print("3. [ ] Run Trinity assembly on the paired-end reads")
print("4. [ ] Verify the output file is generated correctly")
print("5. [ ] Check the assembly statistics")
print()

# Set up Trinity command
trinity_binary = "perl"
trinity_script = "./Trinity/Trinity"
input_file1 = "/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-3-13/result_2/biomni_20260429/data/SRX9161265_SRR12681119_2k_1.fastq.gz"
input_file2 = "/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-3-13/result_2/biomni_20260429/data/SRX9161265_SRR12681119_2k_2.fastq.gz"

# Create output directory for Trinity
trinity_output_dir = "trinity_out_dir"
os.makedirs(trinity_output_dir, exist_ok=True)

# Trinity command with basic parameters
trinity_cmd = [
    trinity_binary, trinity_script,
    "--seqType", "fq",
    "--left", input_file1,
    "--right", input_file2,
    "--output", trinity_output_dir,
    "--CPU", "2",  # Limit CPU usage
    "--max_memory", "4G",  # Limit memory usage
    "--min_contig_length", "200",  # Minimum contig length
    "--no_salmon"  # Skip salmon quantification to speed up
]

print(f"Running Trinity command:")
print(" ".join(trinity_cmd))
print()

# Run Trinity assembly
start_time = time.time()
try:
    result = subprocess.run(trinity_cmd, 
                          capture_output=True, text=True, timeout=1800)  # 30 minutes timeout
    end_time = time.time()
    
    print(f"Trinity completed in {end_time - start_time:.2f} seconds")
    print(f"Return code: {result.returncode}")
    
    if result.returncode == 0:
        print("Trinity assembly completed successfully!")
    else:
        print("Trinity assembly failed.")
        print(f"Error output: {result.stderr[:1000]}")  # First 1000 chars of error
        
    if result.stdout:
        print(f"Standard output: {result.stdout[-500:]}")  # Last 500 chars of output
        
except subprocess.TimeoutExpired:
    print("Trinity assembly timed out after 30 minutes")
except Exception as e:
    print(f"Error running Trinity: {e}")
</execute>
