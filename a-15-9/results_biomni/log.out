<execute>
print("Fixing correlation calculation...")

# The issue is that we need to calculate correlations between features (genes/proteins), not samples
# So we need to transpose the expression data first, then calculate correlations

# Calculate correlation matrix between features (each column is a feature)
print("Calculating feature-feature correlation matrix...")
feature_corr = expr_data.corr()  # This gives feature-feature correlations
print(f"Feature correlation matrix shape: {feature_corr.shape}")

# Convert correlation to distance (1 - |correlation|) 
dist_matrix = 1 - np.abs(feature_corr)

# Convert to condensed distance matrix for scipy linkage
from scipy.spatial.distance import squareform
condensed_dist = squareform(dist_matrix, checks=False)

# Perform hierarchical clustering
print("Performing hierarchical clustering on features...")
linkage_matrix = linkage(condensed_dist, method='average')

# Cut tree to get modules
n_modules = 15  # Increase number for better module resolution
modules = fcluster(linkage_matrix, n_modules, criterion='maxclust')

print(f"Identified {n_modules} modules")

# Create a mapping of features to modules
feature_names = expr_data.columns
module_assignment = pd.DataFrame({
    'Feature': feature_names,
    'Module': modules
})

module_counts = pd.Series(modules).value_counts().sort_index()
print("Module sizes:")
print(module_counts)
