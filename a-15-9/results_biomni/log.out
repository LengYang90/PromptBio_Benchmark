<execute>
#!R
# Step 4: Calculate module eigengenes
print("Step 4: Calculating module eigengenes...")

# Function to calculate module eigengene (first principal component)
calculate_module_eigengene <- function(expr_data, module_genes) {
    if (length(module_genes) == 1) {
        # If only one gene, return the expression directly
        return(expr_data[, module_genes])
    } else {
        # Calculate first principal component
        module_expr <- expr_data[, module_genes]
        pca <- prcomp(module_expr, scale. = TRUE)
        return(pca$x[, 1])
    }
}

# Calculate eigengenes for each module
