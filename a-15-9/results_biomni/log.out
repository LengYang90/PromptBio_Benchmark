<execute>
# Step 4: Calculate module eigengenes
print("\nStep 4: Calculating module eigengenes...")

def calculate_module_eigengene(expr_data, module_features):
    """Calculate the first principal component (eigengene) for a module"""
    if len(module_features) == 1:
        # If only one feature, return its expression directly
        return expr_data[module_features[0]]
    else:
        # Calculate first principal component
        module_expr = expr_data[module_features]
        pca = PCA(n_components=1)
        eigengene = pca.fit_transform(module_expr.values)
        return eigengene.flatten()

# Calculate eigengenes for each module
module_eigengenes = pd.DataFrame(index=expr_data.index)

for module_id in range(1, n_modules + 1):
    # Get features in this module
    module_features = module_assignment[module_assignment['Module'] == module_id]['Feature'].tolist()
    
    if len(module_features) > 0:
        eigengene = calculate_module_eigengene(expr_data, module_features)
        module_eigengenes[f'Module{module_id}'] = eigengene
        print(f"Module {module_id}: {len(module_features)} features")

print(f"\nCalculated eigengenes for {len(module_eigengenes.columns)} modules")
print(f"Module eigengenes shape: {module_eigengenes.shape}")
</execute>
