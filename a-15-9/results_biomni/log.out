<execute>
import pandas as pd
import numpy as np
from scipy.cluster.hierarchy import linkage, fcluster
from scipy.stats import pearsonr
from sklearn.decomposition import PCA
import matplotlib.pyplot as plt
import seaborn as sns
from scipy.spatial.distance import pdist, squareform

print("=== WGCNA-style Analysis in Python ===")

# Load the prepared data
expr_data = pd.read_csv("/tmp/expr_data.csv", index_col=0)
trait_data = pd.read_csv("/tmp/trait_data.csv", index_col=0)

print(f"Expression data: {expr_data.shape[0]} samples x {expr_data.shape[1]} features")
print(f"Trait data: {trait_data.shape[0]} samples x {trait_data.shape[1]} traits")

# Step 3: Module detection using hierarchical clustering
print("\nStep 3: Detecting co-expression modules...")

# Calculate correlation matrix between features (transpose to get feature correlations)
cor_matrix = expr_data.T.corr()
print(f"Correlation matrix shape: {cor_matrix.shape}")

# Convert correlation to distance (1 - |correlation|)
dist_matrix = 1 - np.abs(cor_matrix)

# Perform hierarchical clustering
print("Performing hierarchical clustering...")
# Convert to condensed distance matrix for linkage
condensed_dist = pdist(dist_matrix, metric='euclidean')
linkage_matrix = linkage(condensed_dist, method='average')

# Cut tree to get modules
n_modules = 10
modules = fcluster(linkage_matrix, n_modules, criterion='maxclust')

print(f"Identified {n_modules} modules")
module_counts = pd.Series(modules).value_counts().sort_index()
print("Module sizes:")
print(module_counts)
</execute>
