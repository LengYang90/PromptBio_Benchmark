<execute>
# Step 5: Calculate correlations between module eigengenes and disease status
print("\nStep 5: Testing module-trait associations...")

# Get the disease trait
disease_trait = trait_data['Disease']

# Calculate correlations and p-values
correlation_results = []

for module_name in module_eigengenes.columns:
    eigengene = module_eigengenes[module_name]
    
    # Calculate Pearson correlation
    correlation, p_value = pearsonr(eigengene, disease_trait)
    
    correlation_results.append({
        'Module': module_name,
        'Correlation': correlation,
        'Pvalue': p_value
    })
    
    print(f"{module_name}: r = {correlation:.4f}, p = {p_value:.4f}")

# Create results dataframe
results_df = pd.DataFrame(correlation_results)
print(f"\nCorrelation analysis completed for {len(results_df)} modules")

# Display summary
print("\nTop 5 modules by absolute correlation:")
top_modules = results_df.reindex(results_df['Correlation'].abs().sort_values(ascending=False).index).head()
print(top_modules)
</execute>
