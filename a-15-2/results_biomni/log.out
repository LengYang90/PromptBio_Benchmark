<execute>
#!R
# Complete cell-type-specific cis-QTL analysis
cat("=== Complete Cell-type-specific cis-QTL Analysis ===\n")

# Load all data files
snp_data <- read.csv("/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-15-2/result_10/biomni_20260516/data/Matrix_of_SNP_genotypes.csv", row.names = 1, check.names = FALSE)
meth_data <- read.csv("/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-15-2/result_10/biomni_20260516/data/Matrix_of_bulk_omics_measurements.csv", row.names = 1, check.names = FALSE)
meth_pos <- read.csv("/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-15-2/result_10/biomni_20260516/data/Matrix_of_bulk_omics_positions.csv", row.names = 1)
snp_pos <- read.csv("/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-15-2/result_10/biomni_20260516/data/Matrix_of_trait_positions.csv", row.names = 1)
cell_comp <- read.csv("/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-15-2/result_10/biomni_20260516/data/Matrix_of_cell_type_composition.csv", row.names = 1)
covariates <- read.csv("/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-15-2/result_10/biomni_20260516/data/Matrix_of_ovariates.csv", row.names = 1)

# Set parameters
cis_window <- 1000000  # 1 Mb
cell_types <- colnames(cell_comp)

cat("Data loaded successfully\n")
cat("Parameters: cis window =", cis_window, "bp\n")
cat("Cell types:", paste(cell_types, collapse = ", "), "\n")

# Initialize results storage
all_results <- data.frame(
  term = character(),
  response = character(),
  celltype = character(),
  estimate = numeric(),
  statistic = numeric(),
  p.value = numeric(),
  stringsAsFactors = FALSE
)

# Perform cis-QTL analysis
cat("Starting analysis...\n")
total_associations <- 0

for (i in 1:nrow(snp_data)) {
  snp_id <- rownames(snp_data)[i]
  snp_position <- snp_pos[snp_id, "Position"]
  
  for (j in 1:nrow(meth_data)) {
    cpg_id <- rownames(meth_data)[j]
    cpg_position <- meth_pos[cpg_id, "Position"]
    distance <- abs(snp_position - cpg_position)
    
    # Check if within cis window
    if (distance <= cis_window) {
      for (cell_type in cell_types) {
        tryCatch({
          # Extract data
          snp_vals <- as.numeric(snp_data[i, ])
          cpg_vals <- as.numeric(meth_data[j, ])
          cell_props <- cell_comp[, cell_type]
          
          # Create interaction term
          interaction <- snp_vals * cell_props
          
          # Prepare regression data
          reg_df <- data.frame(
            cpg = cpg_vals,
            snp = snp_vals,
            cell_prop = cell_props,
            interaction = interaction,
            pc1 = covariates$PC1,
            pc2 = covariates$PC2,
            pc3 = covariates$PC3
          )
          
          # Remove missing values
          reg_df <- reg_df[complete.cases(reg_df), ]
          
          # Fit model if enough data points
          if (nrow(reg_df) >= 10) {
            model <- lm(cpg ~ snp + cell_prop + interaction + pc1 + pc2 + pc3, data = reg_df)
            model_summary <- summary(model)
            coef_table <- model_summary$coefficients
            
            # Extract interaction term results
            if ("interaction" %in% rownames(coef_table)) {
              new_result <- data.frame(
                term = snp_id,
                response = cpg_id,
                celltype = cell_type,
                estimate = coef_table["interaction", "Estimate"],
                statistic = coef_table["interaction", "t value"],
                p.value = coef_table["interaction", "Pr(>|t|)"],
                stringsAsFactors = FALSE
              )
              
              all_results <- rbind(all_results, new_result)
              total_associations <- total_associations + 1
            }
          }
        }, error = function(e) {
          # Skip on error
        })
      }
    }
  }
}

cat("Analysis completed!\n")
cat("Total associations tested:", total_associations, "\n")

# Save results
output_file <- "/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-15-2/result_10/biomni_20260516/mQTL_results.tsv"
write.table(all_results, file = output_file, sep = "\t", row.names = FALSE, quote = FALSE)

cat("Results saved to:", output_file, "\n")
cat("Total results:", nrow(all_results), "\n")

# Display summary
if (nrow(all_results) > 0) {
  cat("\nSummary statistics:\n")
  cat("Unique SNPs:", length(unique(all_results$term)), "\n")
  cat("Unique CpGs:", length(unique(all_results$response)), "\n")
  cat("Significant results (p < 0.05):", sum(all_results$p.value < 0.05), "\n")
  cat("Mean |estimate|:", round(mean(abs(all_results$estimate)), 4), "\n")
  
  cat("\nFirst 10 results:\n")
  print(head(all_results, 10))
}

cat("\nAnalysis complete!\n")
</execute>
