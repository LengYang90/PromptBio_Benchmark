<execute>
#!R
# Check if omicwas package is available
if (!require("omicwas", quietly = TRUE)) {
    # Try to install from CRAN first
    if (!require("devtools", quietly = TRUE)) {
        install.packages("devtools", repos = "https://cran.r-project.org/")
    }
    
    # Install omicwas from GitHub if not available on CRAN
    tryCatch({
        devtools::install_github("Oshlack/omicwas")
    }, error = function(e) {
        cat("Error installing omicwas:", e$message, "\n")
        cat("Attempting alternative installation...\n")
        # Try alternative installation methods if needed
    })
}

# Load required libraries
library(omicwas)
cat("omicwas package loaded successfully\n")
</execute>
