  celltype = character(),
  estimate = numeric(),
  statistic = numeric(),
  p.value = numeric(),
  stringsAsFactors = FALSE
)

# Function for cell-type-specific QTL analysis
perform_ctQTL <- function(snp_id, cpg_id, cell_type) {
  tryCatch({
    # Get data
    snp_values <- as.numeric(snp_data[snp_id, ])
    cpg_values <- as.numeric(meth_data[cpg_id, ])
    cell_prop <- cell_comp[, cell_type]
    
    # Create interaction term
    interaction_term <- snp_values * cell_prop
    
    # Prepare regression data
    reg_data <- data.frame(
      cpg = cpg_values,
      snp = snp_values,
      cell_prop = cell_prop,
      interaction = interaction_term,
      pc1 = covariates$PC1,
      pc2 = covariates$PC2,
      pc3 = covariates$PC3
    )
    
    # Remove missing data
    reg_data <- reg_data[complete.cases(reg_data), ]
    
    if (nrow(reg_data) < 10) return(NULL)
    
    # Fit model
    model <- lm(cpg ~ snp + cell_prop + interaction + pc1 + pc2 + pc3, data = reg_data)
    coef_table <- summary(model)$coefficients
    
    if ("interaction" %in% rownames(coef_table)) {
      return(data.frame(
        term = snp_id,
        response = cpg_id,
        celltype = cell_type,
        estimate = coef_table["interaction", "Estimate"],
        statistic = coef_table["interaction", "t value"],
        p.value = coef_table["interaction", "Pr(>|t|)"],
        stringsAsFactors = FALSE
      ))
    }
    return(NULL)
  }, error = function(e) NULL)
}

# Perform analysis
cat("Starting cis-QTL analysis...\n")
total_tests <- 0

for (snp_id in rownames(snp_data)) {
  snp_position <- snp_pos[snp_id, "Position"]
  
  for (cpg_id in rownames(meth_data)) {
    cpg_position <- meth_pos[cpg_id, "Position"]
    distance <- abs(snp_position - cpg_position)
    
    if (distance <= cis_window) {
      cat("Testing", snp_id, "vs", cpg_id, "(distance:", distance, "bp)\n")
      
      for (cell_type in cell_types) {
        total_tests <- total_tests + 1
        result <- perform_ctQTL(snp_id, cpg_id, cell_type)
        
        if (!is.null(result)) {
          results <- rbind(results, result)
        }
      }
    }
  }
}

