Now let me implement the cell-type-specific cis-QTL analysis manually since the omicwas package is not available:

<execute>
#!R
# Implement cell-type-specific cis-QTL analysis
cat("Implementing cell-type-specific cis-QTL analysis...\n")

# Set cis window (1 Mb = 1,000,000 bp)
cis_window <- 1000000

# Get sample names (should be consistent across all matrices)
samples <- colnames(snp_data)
cat("Number of samples:", length(samples), "\n")

# Cell types
cell_types <- colnames(cell_comp)
cat("Cell types:", paste(cell_types, collapse = ", "), "\n")

# Initialize results dataframe
results <- data.frame(
  term = character(),
  response = character(),
  celltype = character(),
  estimate = numeric(),
  statistic = numeric(),
  p.value = numeric(),
  stringsAsFactors = FALSE
)

# Function to perform cell-type-specific QTL analysis
perform_ctQTL <- function(snp_id, cpg_id, cell_type) {
  # Get SNP and CpG data for the samples
  snp_values <- as.numeric(snp_data[snp_id, samples])
  cpg_values <- as.numeric(meth_data[cpg_id, samples])
  
  # Get cell type proportions
  cell_prop <- cell_comp[samples, cell_type]
  
  # Get covariates
  cov_data <- covariates[samples, ]
  
  # Create interaction term (SNP * cell type proportion)
  interaction_term <- snp_values * cell_prop
  
  # Prepare data for regression
  reg_data <- data.frame(
    cpg = cpg_values,
    snp = snp_values,
    cell_prop = cell_prop,
    interaction = interaction_term,
    pc1 = cov_data$PC1,
    pc2 = cov_data$PC2,
    pc3 = cov_data$PC3
  )
  
  # Remove any rows with missing data
  complete_rows <- complete.cases(reg_data)
  reg_data <- reg_data[complete_rows, ]
  
  if (nrow(reg_data) < 10) {  # Need sufficient data points
    return(NULL)
  }
  
  # Fit linear model with interaction term
  # Model: CpG ~ SNP + cell_prop + SNP*cell_prop + covariates
  tryCatch({
    model <- lm(cpg ~ snp + cell_prop + interaction + pc1 + pc2 + pc3, data = reg_data)
    
    # Extract results for the interaction term (this represents cell-type-specific effect)
    summary_model <- summary(model)
    coef_table <- summary_model$coefficients
    
    if ("interaction" %in% rownames(coef_table)) {
      estimate <- coef_table["interaction", "Estimate"]
      statistic <- coef_table["interaction", "t value"]
      p_value <- coef_table["interaction", "Pr(>|t|)"]
      
      return(data.frame(
        term = snp_id,
        response = cpg_id,
        celltype = cell_type,
        estimate = estimate,
        statistic = statistic,
        p.value = p_value,
        stringsAsFactors = FALSE
      ))
    }
    
    return(NULL)
  }, error = function(e) {
    return(NULL)
  })
}

cat("Starting cis-QTL analysis...\n")

# Perform cis-QTL analysis for each SNP-CpG pair within the cis window
total_tests <- 0
significant_results <- 0

for (snp_id in rownames(snp_data)) {
  snp_position <- snp_pos[snp_id, "Position"]
  
  for (cpg_id in rownames(meth_data)) {
    cpg_position <- meth_pos[cpg_id, "Position"]
    
    # Check if SNP and CpG are within cis window
    distance <- abs(snp_position - cpg_position)
    
    if (distance <= cis_window) {
      # Test for each cell type
      for (cell_type in cell_types) {
        total_tests <- total_tests + 1
        
        result <- perform_ctQTL(snp_id, cpg_id, cell_type)
        
        if (!is.null(result)) {
          results <- rbind(results, result)
          if (result$p.value < 0.05) {
            significant_results <- significant_results + 1
          }
        }
        
        # Print progress every 100 tests
        if (total_tests %% 100 == 0) {
          cat("Completed", total_tests, "tests...\n")
        }
      }
    }
  }
}

cat("Analysis completed!\n")
cat("Total tests performed:", total_tests, "\n")
cat("Total results:", nrow(results), "\n")
cat("Significant results (p < 0.05):", significant_results, "\n")
</execute>
