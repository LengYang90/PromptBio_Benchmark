    cpg_id <- rownames(meth_data)[j]
    cpg_position <- meth_pos[cpg_id, "Position"]
    distance <- abs(snp_position - cpg_position)
    
    if (distance <= cis_window) {
      cat("Processing", snp_id, "vs", cpg_id, "\n")
      
      for (cell_type in cell_types) {
        tryCatch({
          # Get data vectors
          snp_vals <- as.numeric(snp_data[i, ])
          cpg_vals <- as.numeric(meth_data[j, ])
          cell_props <- cell_comp[, cell_type]
          interaction <- snp_vals * cell_props
          
          # Create data frame
          df <- data.frame(
            cpg = cpg_vals,
            snp = snp_vals,
            cell_prop = cell_props,
            interaction = interaction,
            pc1 = covariates$PC1,
            pc2 = covariates$PC2,
            pc3 = covariates$PC3
          )
          
          # Remove missing values
          df <- df[complete.cases(df), ]
          
          if (nrow(df) >= 10) {
            # Fit model
            model <- lm(cpg ~ snp + cell_prop + interaction + pc1 + pc2 + pc3, data = df)
            coefs <- summary(model)$coefficients
            
            if ("interaction" %in% rownames(coefs)) {
              result_count <- result_count + 1
              results_list[[result_count]] <- data.frame(
                term = snp_id,
                response = cpg_id,
                celltype = cell_type,
                estimate = coefs["interaction", "Estimate"],
                statistic = coefs["interaction", "t value"],
                p.value = coefs["interaction", "Pr(>|t|)"],
                stringsAsFactors = FALSE
              )
            }
          }
        }, error = function(e) {
          cat("Error with", snp_id, cpg_id, cell_type, ":", e$message, "\n")
        })
      }
    }
  }
}

# Combine results
if (length(results_list) > 0) {
  final_results <- do.call(rbind, results_list)
  cat("Analysis completed successfully!\n")
  cat("Total results:", nrow(final_results), "\n")
  print(head(final_results))
} else {
  cat("No results generated\n")
  final_results <- data.frame(
    term = character(),
    response = character(),
    celltype = character(),
    estimate = numeric(),
    statistic = numeric(),
    p.value = numeric()
  )
}
</execute>
