import requests
import json

print("=== Step 3: Attempting to find DIA-NN or alternative ===")

# Try to get DIA-NN releases info
try:
    response = requests.get("https://api.github.com/repos/vdemichev/DiaNN/releases", timeout=10)
    if response.status_code == 200:
        releases = response.json()
        print(f"Found {len(releases)} DIA-NN releases")
        if releases:
            latest = releases[0]
            print(f"Latest version: {latest['tag_name']}")
            for asset in latest.get('assets', []):
                if 'linux' in asset['name'].lower():
                    print(f"Linux asset: {asset['name']} - {asset['browser_download_url']}")
    else:
        print(f"Failed to get releases: {response.status_code}")
except Exception as e:
    print(f"Error accessing GitHub API: {e}")

# Check if we have any Python proteomics libraries available
print("\n=== Checking for Python proteomics libraries ===")
try:
    import pyteomics
    print("pyteomics is available")
except ImportError:
    print("pyteomics not available")

