import pymzml

print("=== Step 8: Analyzing the mzML file ===")

# Check the mzML file structure using pymzml
try:
    print("Attempting to read mzML file with pymzml...")
    msrun = pymzml.run.Reader(mzml_file)
    
    spectrum_count = 0
    ms1_count = 0
    ms2_count = 0
    
    for spectrum in msrun:
        spectrum_count += 1
        if spectrum.ms_level == 1:
            ms1_count += 1
        elif spectrum.ms_level == 2:
            ms2_count += 1
        
        # Only check first few spectra to avoid long processing
        if spectrum_count >= 10:
            break
    
    print(f"Successfully read mzML file")
    print(f"First 10 spectra: MS1={ms1_count}, MS2={ms2_count}")
    
    # Get total spectrum count (this might take a moment)
    msrun = pymzml.run.Reader(mzml_file)
    total_spectra = 0
    for spectrum in msrun:
        total_spectra += 1
        if total_spectra % 1000 == 0:
            print(f"Processed {total_spectra} spectra...")
        if total_spectra >= 5000:  # Limit check to first 5000 spectra
            print(f"Checked first {total_spectra} spectra - file appears valid")
            break
    
except Exception as e:
    print(f"Error reading mzML file: {e}")
    print("The mzML file might be corrupted or in an incompatible format")
</execute>
