<execute>
# Set up the DIA-NN command with proper parameters
diann_executable = "/tmp/diann_install/diann-2.5.1/diann-linux"
mzml_file = "/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-7-8/result_10/biomni_20260516/data/RD139_Narrow_UPS1_0_1fmol_inj1.mzML"
fasta_file = "/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-7-8/result_10/biomni_20260516/data/REF_EColi_K12_UPS1_combined.fasta"
output_file = "/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-7-8/result_10/biomni_20260516/report.tsv"
output_dir = os.path.dirname(output_file)

print("=== Step 4: Setting up DIA-NN command ===")
print(f"DIA-NN executable: {diann_executable}")
print(f"Input mzML file: {mzml_file}")
print(f"Input FASTA file: {fasta_file}")
print(f"Output file: {output_file}")
print(f"Output directory: {output_dir}")

# Construct the DIA-NN command for label-free quantification
diann_cmd = [
    diann_executable,
    "--f", mzml_file,                    # Input mzML file
    "--fasta", fasta_file,               # FASTA database
    "--fasta-search",                    # Perform library-free search
    "--predictor",                       # Use deep learning predictor
    "--out", output_file,                # Output report file
    "--threads", "8",                    # Number of threads
    "--relaxed-prot-inf"                 # Relaxed protein inference for benchmarking
]

print(f"\nDIA-NN command: {' '.join(diann_cmd)}")
</execute>
