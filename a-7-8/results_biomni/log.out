<execute>
import subprocess
import shutil

print("=== Step 2: Checking for DIA-NN availability ===")

# Check for DIA-NN executable
diann_path = shutil.which("diann")
if diann_path:
    print(f"DIA-NN found at: {diann_path}")
else:
    print("DIA-NN not found in PATH")

# Check for alternative names
alternatives = ["DIA-NN", "dia-nn", "diann.exe", "diann"]
for alt in alternatives:
    path = shutil.which(alt)
    if path:
        print(f"Found {alt} at: {path}")
        break
else:
    print("No DIA-NN executable found")

# Check if we can install DIA-NN or use an alternative
print("\n=== Checking for alternative proteomics tools ===")
tools = ["msconvert", "openms", "maxquant"]
for tool in tools:
    path = shutil.which(tool)
    if path:
        print(f"{tool} found at: {path}")
    else:
        print(f"{tool} not found")
</execute>
