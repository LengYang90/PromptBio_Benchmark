FASTA_FILE="/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-7-8/result_10/toolsgenie_20260516/data/REF_EColi_K12_UPS1_combined.fasta"

# Output file path
OUTPUT_REPORT="/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-7-8/result_10/toolsgenie_20260516/report.tsv"

echo "=== DIA-NN LIBRARY-FREE DIA ANALYSIS ==="

# Run DIA-NN with library-free mode for E. coli data
diann \
  --f "$MZML_FILE" \
  --fasta "$FASTA_FILE" \
  --out "$OUTPUT_REPORT" \
  --lib "" \
  --threads 0 \
  --verbose 1 \
  --out-lib speclib.tsv \
  --gen-spec-lib \
  --predictor \
  --fasta-search \
  --min-fr-mz 200 \
  --max-fr-mz 1800 \
  --met-excision \
  --cut K*,R* \
  --missed-cleavages 1 \
  --min-pep-len 7 \
  --max-pep-len 30 \
  --min-pr-mz 300 \
  --max-pr-mz 1800 \
  --min-pr-charge 1 \
  --max-pr-charge 4 \
  --unimod4 \
  --var-mods 1 \
  --var-mod "UniMod:35,15.994915,M" \
  --reanalyse \
  --relaxed-prot-inf \
  --pg-level 1

echo "=== DIA-NN ANALYSIS COMPLETED ==="

# Verify output file
echo "Output file verification:"
ls -lh "$OUTPUT_REPORT"
echo "First few lines of report.tsv:"
head -5 "$OUTPUT_REPORT"

