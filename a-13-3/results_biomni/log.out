print(f"✓ Created assembled_plasmid.csv with {len(plasmid_df)} row(s)")
print(f"  - Sequence length: {total_length} bp")

# Create plasmid_map.txt
with open(map_output, 'w') as f:
    f.write("PLASMID MAP\n")
    f.write("=" * 50 + "\n")
    f.write(f"Total Length: {total_length} bp\n")
    f.write(f"Construct Type: Circular plasmid\n")
    f.write(f"Assembly Method: Golden Gate cloning with BsaI\n\n")
    
    f.write("PART POSITIONS:\n")
    f.write("-" * 50 + "\n")
    
    for part_info in part_positions:
        f.write(f"{part_info['name']:<20} {part_info['start']:>4}–{part_info['end']:<4} bp ({part_info['length']:>3} bp)\n")
    
    f.write("\nASSEMBLY ORDER:\n")
    f.write("-" * 50 + "\n")
    for i, part_info in enumerate(part_positions, 1):
        f.write(f"{i}. {part_info['name']}\n")
    
    f.write(f"\nOVERHANGS USED:\n")
    f.write("-" * 50 + "\n")
    for i, overhang in enumerate(overhangs):
        f.write(f"{parts[i]['name']}: {overhang}\n")

print(f"✓ Created plasmid_map.txt with part position details")

# Verify the files were created
print(f"\nOutput files created:")
print(f"1. {csv_output} - {'✓ exists' if os.path.exists(csv_output) else '✗ missing'}")
print(f"2. {map_output} - {'✓ exists' if os.path.exists(map_output) else '✗ missing'}")

# Show a preview of the files
print(f"\nPreview of assembled_plasmid.csv:")
print(plasmid_df.head())

print(f"\nPreview of plasmid_map.txt:")
with open(map_output, 'r') as f:
    content = f.read()
    print(content)
