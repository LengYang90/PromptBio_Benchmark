print("Step 3: ✓ Extracted overhangs and prepared fragments")
print("Step 4: Performing Golden Gate assembly simulation...")

# For Golden Gate assembly, we need to use the backbone as the starting point
# and the other parts as fragments to be inserted
backbone_sequence = parts[3]['sequence']  # part4_backbone

# Prepare fragments for the golden_gate_assembly function
assembly_fragments = []

# Add fragments in the specified order: promoter → gene → terminator
for i in [0, 1, 2]:  # Skip backbone (index 3)
    fragment = {
        'name': parts[i]['name'],
        'sequence': parts[i]['sequence']
    }
    assembly_fragments.append(fragment)

print(f"Backbone: {parts[3]['name']} ({len(parts[3]['sequence'])} bp)")
print(f"Fragments to insert: {len(assembly_fragments)}")
for frag in assembly_fragments:
    print(f"  - {frag['name']} ({len(frag['sequence'])} bp)")

# Perform Golden Gate assembly
try:
    assembly_result = golden_gate_assembly(
        backbone_sequence=backbone_sequence,
        enzyme_name="BsaI",
        fragments=assembly_fragments,
        is_circular=True
    )
    
    print("\nGolden Gate assembly completed!")
    print(f"Assembly result type: {type(assembly_result)}")
    print(f"Assembly result keys: {assembly_result.keys() if isinstance(assembly_result, dict) else 'Not a dict'}")
    
except Exception as e:
    print(f"Error during Golden Gate assembly: {e}")
    print("Let me try a different approach...")
</execute>
