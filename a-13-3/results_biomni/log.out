Now let me extract the overhangs and prepare the fragments for Golden Gate assembly:

<execute>
print("Step 2: ✓ Analyzed BsaI restriction sites")
print("Step 3: Extracting overhangs and preparing fragments for Golden Gate assembly...")

# Extract the 4-nucleotide overhangs after BsaI digestion
# BsaI cuts after position 7 (GGTCTC|N^NNNN), so the overhang starts at position 7
fragments = []

for i, part in enumerate(parts):
    seq = part['sequence']
    # BsaI site is at the beginning: GGTCTC + 4nt overhang
    # The overhang is the 4 nucleotides after GGTCTC
    overhang = seq[6:10]  # positions 6-9 (0-based) = positions 7-10 (1-based)
    
    # The actual fragment sequence is everything after the BsaI site and overhang
    fragment_seq = seq[10:-10]  # Remove BsaI sites from both ends
    
    fragment_info = {
        'name': part['name'],
        'sequence': fragment_seq,
        'overhang_5': overhang
    }
    fragments.append(fragment_info)
    
    print(f"Fragment {i+1}: {part['name']}")
    print(f"  5' overhang: {overhang}")
    print(f"  Fragment length: {len(fragment_seq)} bp")
    print(f"  Fragment sequence: {fragment_seq[:30]}...{fragment_seq[-30:]}")
    print()

print("Fragments prepared for Golden Gate assembly")
</execute>
