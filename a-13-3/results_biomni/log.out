Let me try a manual approach to understand the overhangs better and perform the assembly:

<execute>
print("Step 4: Manual Golden Gate assembly approach...")

# Let's manually extract the overhangs and perform assembly
def extract_bsai_overhangs(sequence):
    """Extract the 4-nucleotide overhangs created by BsaI digestion"""
    # BsaI recognition site: GGTCTC, cuts 1 nt downstream on sense strand
    # This creates a 4-nucleotide 3' overhang
    
    # Find BsaI site at the beginning
    if sequence.startswith('GGTCTC'):
        # 5' overhang is the 4 nucleotides after GGTCTC
        overhang_5 = sequence[6:10]
        # Remove the BsaI site and overhang from 5' end
        processed_seq = sequence[10:]
    else:
        overhang_5 = None
        processed_seq = sequence
    
    # Find BsaI site at the end (reverse complement)
    # GGTCTC reverse complement is GAGACC
    if processed_seq.endswith('GAGACC'):
        # 3' overhang is the 4 nucleotides before GAGACC
        overhang_3 = processed_seq[-10:-6]
        # Remove the BsaI site and overhang from 3' end
        processed_seq = processed_seq[:-10]
    else:
        overhang_3 = None
    
    return overhang_5, processed_seq, overhang_3

# Process each part
processed_parts = []
for i, part in enumerate(parts):
    overhang_5, core_seq, overhang_3 = extract_bsai_overhangs(part['sequence'])
    
    processed_parts.append({
        'name': part['name'],
        'original_length': len(part['sequence']),
        'core_sequence': core_seq,
        'core_length': len(core_seq),
        'overhang_5': overhang_5,
        'overhang_3': overhang_3
    })
    
    print(f"Part {i+1}: {part['name']}")
    print(f"  Original length: {len(part['sequence'])} bp")
    print(f"  5' overhang: {overhang_5}")
    print(f"  3' overhang: {overhang_3}")
    print(f"  Core sequence length: {len(core_seq)} bp")
    print(f"  Core sequence: {core_seq[:30]}...{core_seq[-30:] if len(core_seq) > 60 else core_seq}")
    print()
</execute>
