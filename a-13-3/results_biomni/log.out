# First, let's read the input FASTA file to understand what we're working with
from Bio import SeqIO
import pandas as pd
import os

# Read the DNA parts from the FASTA file
input_file = "/mnt/data/lengyang/youjia_project/autoba/BABench/src/promptbio-bench/tasks/a-13-3/result_2/biomni_20260429/data/dna_parts.fasta"

print("Reading DNA parts from FASTA file...")
parts = []
for record in SeqIO.parse(input_file, "fasta"):
    parts.append({
        'name': record.id,
        'description': record.description,
        'sequence': str(record.seq)
    })
    print(f"Part: {record.id}")
    print(f"Description: {record.description}")
    print(f"Length: {len(record.seq)} bp")
    print(f"Sequence preview: {str(record.seq)[:100]}...")
    print("-" * 50)

print(f"Total parts found: {len(parts)}")
</execute>
